# Multi-stage build for PAP service
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go/go.mod go/go.sum ./go/
# Copy local replace modules needed for dependency resolution
COPY third_party/gin/go.mod third_party/gin/go.sum ./third_party/gin/

# Download dependencies
WORKDIR /app/go
RUN go mod download

# Copy source code
WORKDIR /app
COPY go/ ./go/
COPY third_party/gin/ ./third_party/gin/

# Ensure local replace module is available for builds
WORKDIR /app/third_party/gin
RUN go mod download

WORKDIR /app/go

# Build the PAP server
ARG GOFIPS140=""
ARG BUILD_TAGS=""
ARG BUILD_FEATURES=""
RUN CGO_ENABLED=0 GOOS=linux GOFIPS140=${GOFIPS140} \
    go build -tags "${BUILD_TAGS}" \
    -ldflags "-X 'stratium/features.BuildFeatures=${BUILD_FEATURES}'" \
    -a -installsuffix cgo -o /app/pap-server ./cmd/pap-server

# Final stage
FROM cgr.dev/chainguard/wolfi-base:latest

# Install runtime dependencies
RUN apk --no-cache add ca-certificates wget netcat-openbsd

# Create non-root user
RUN addgroup -g 1000 stratium && \
    adduser -D -u 1000 -G stratium stratium

WORKDIR /home/stratium

# Copy binary from builder
COPY --from=builder --chown=stratium:stratium /app/pap-server .

# Switch to non-root user
USER stratium

# Expose port
EXPOSE 8090

# Run the server
CMD ["./pap-server"]
