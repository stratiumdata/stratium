.superpowers/

# Build artifacts
/services/bin/
*.out
!**/testdata/*.out

# Terraform state — resource identifiers, sometimes secrets
*.tfstate
*.tfstate.*
.terraform/

# Local environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/

# Node (clients/ui, later phases)
node_modules/
dist/

# deploy/stratium quickstart — machine-local identity and build output.
# Nothing here is shareable: the agent id belongs to one local tenant and the
# binary is built per-machine. Ports and tokens are never written to disk at all.
/.stratium-quickstart.json
/.stratium-session.json
/.stratium-session.json.cache.json
/bin/

# the examples' shared delegation — bearer authority, never committed
/example/.session.json
/example/.session.json.cache.json
/example/depth/hook/.session-parent.json
/example/depth/hook/.session-parent.json.cache.json
/example/depth/hook/.session-child.json
/example/depth/hook/.session-child.json.cache.json
