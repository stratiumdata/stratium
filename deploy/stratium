    "STRATIUM_PEP_PDP_ADDR": ('"localhost:$(dc port pdp-pap 50051 | sed -E \'s/.*://\')"',
                              "ephemeral — re-resolve after every `compose up`"),
    "STRATIUM_PEP_AGENT_ID": ('"$AGENT"', "the agent row from 0d"),
    "STRATIUM_PEP_SUBJECT": '"agent-tester@example.com"',
    "STRATIUM_PEP_SESSION_FILE": '"/tmp/stratium-session.json"',
    "STRATIUM_PEP_CONNECT_TIMEOUT": "5s",
    "STRATIUM_PEP_REQUESTED_TIER": "3",
    "STRATIUM_PEP_REQUESTED_TOOLS": '"Read,Grep,Glob,Write,Bash"',
    "STRATIUM_PEP_TTL_SECONDS": "3600",
    "STRATIUM_PEP_APPROVAL_POLL_INTERVAL": "2s",
    "STRATIUM_PEP_APPROVAL_TIMEOUT": "120s",
}

DC = 'dc() { docker compose -f deploy/docker/docker-compose.yml "$@"; }'


def next_steps(events, agent="claude", binary="stratium-pep"):
    """Print the exports the installed hooks need, and what to run after them.

    Only the ones missing from *this* shell are printed, which is a hint and not
    the truth: the hooks read the environment of whatever shell launches the
    agent. Printing the whole block every time would bury that.
    """
    need = []
    for e in events:
        for v in REQUIRED_ENV.get(e, ()):
            if v not in need:
                need.append(v)
    gone = [v for v in need if not os.environ.get(v)]

    print(f"\nNEXT — the hooks read their configuration from the environment of the "
          f"shell that launches `{agent}`, not from this one.")
    if not gone:
        print(f"All {len(need)} are set here. If you launch `{agent}` from a different "
              "shell, export them there too.")
    else:
        print(f"{len(gone)} of {len(need)} are missing here. In the launching shell:\n")
        if "STRATIUM_PEP_PDP_ADDR" in gone:
            print(f"  {DC}")
        if not os.environ.get("STRATIUM_PEP_PDP_INSECURE"):
            print("  export STRATIUM_PEP_PDP_INSECURE=true                    "
                  "# the local stack serves plaintext")
        for v in gone:
            spec = EXAMPLES.get(v, '""')
            value, note = spec if isinstance(spec, tuple) else (spec, None)
            line = f"  export {v}={value}"
            if note and len(line) + len(note) + 3 <= 100:
                print(f"{line}{'':<{max(1, 58 - len(line))}}# {note}")
            else:
                if note:
                    print(f"  # {note}")
                print(line)
    if "SessionStart" not in events:
        print(f"\nNo SessionStart hook is installed, so nothing issues a delegation for "
              f"you — run `{binary.split()[0]} session-start` by hand first, or every tool "
              "call denies for want of a session.")
    print(f"\nThen: deploy/stratium --{agent} "
          "status   # 0 when the command resolves and the environment is whole")


def go_seconds(text, default):
    """Seconds in a Go duration string such as "120s", "5m" or "1m30s".

    Anything that does not parse gives `default`: the binary itself rejects a
    bad duration and denies, so this only has to size a timeout, not validate.
    """
    units = {"h": 3600, "m": 60, "s": 1, "ms": 0.001}
    parts = re.findall(r"(\d+(?:\.\d+)?)(ms|h|m|s)", text or "")
    if not parts or "".join(n + u for n, u in parts) != text:
        return default
    return sum(float(n) * units[u] for n, u in parts)


def hook_env(command):
    """The settings a hook command will see: its --config file if it names one
    (the binary then ignores the environment), else this shell's environment."""
    words = (command or "").split()
    if "--config" not in words[:-1]:
        return os.environ
    try:
        with open(words[words.index("--config") + 1]) as f:
            return dict(l.strip().split("=", 1) for l in f
                        if "=" in l and not l.lstrip().startswith("#"))
    except OSError:
        return {}


def hook_timeout(env=os.environ):
    """The PreToolUse `timeout` to install, in seconds.

    A harness that gives up on a hook runs the tool call anyway, so this must be
    larger than the longest the hook can take to answer. That is hookBudget in
    services/cmd/stratium-pep/hook.go: the approval timeout plus four connect
    timeouts. Read from this shell's environment, else the quickstart values.
    """
    approval = go_seconds(env.get("STRATIUM_PEP_APPROVAL_TIMEOUT"), 120)
    connect = go_seconds(env.get("STRATIUM_PEP_CONNECT_TIMEOUT"), 5)
    return math.ceil(approval + 4 * connect) + HOOK_TIMEOUT_MARGIN


def timeout_too_short(event, timeout, env=os.environ):
    """True if an installed PreToolUse timeout would expire before the hook answers."""
    if event != "PreToolUse":
        return False
    return not isinstance(timeout, (int, float)) or timeout < hook_timeout(env)


TIMEOUT_FIX = ("the harness would stop waiting before the hook answers, and then "
               "run the tool call; re-run install")


def missing_env(event, env=os.environ):
    return [v for v in REQUIRED_ENV.get(event, ()) if not env.get(v)]


def entries(binary, matcher, only=None, hook_arg="hook", tail=""):
    """The groups to install, in docs/pep.md's shape. `tail` is appended to
    every command (the system install's ` --config <file>`).

    SessionStart carries no matcher on purpose: it must fire for every session
    source (startup, resume, clear, compact, fork), so a resumed session gets a
    fresh delegation rather than whatever `hook` finds left over.

    The two PostToolUse events run `report`, which tells the PDP a tool call
    ran so it can spot one it never allowed. They take PreToolUse's matcher: a
    wider one would report calls the decision hook was never asked about.
    """
    report = {
        "matcher": matcher,
        "hooks": [{
            "type": "command",
            "command": f"{binary} report{tail}",
            "timeout": REPORT_TIMEOUT,
        }],
    }
    all_events = {
        "SessionStart": {
            "hooks": [{
                "type": "command",
                "command": f"{binary} session-start{tail}",
                "timeout": SESSION_START_TIMEOUT,
            }],
        },
        "PreToolUse": {
            "matcher": matcher,
            "hooks": [{
                "type": "command",
                "command": f"{binary} {hook_arg}".strip() + tail,
                "timeout": hook_timeout(),
            }],
        },
        # A tool call that fails still ran, and arrives on its own event.
        "PostToolUse": report,
        "PostToolUseFailure": json.loads(json.dumps(report)),
    }
    if hook_arg == "hook":
        # Claude Code only (its own setting, which Codex does not have): a hook
        # that times out or crashes then blocks the call instead of letting it run.
        all_events["PreToolUse"]["hooks"][0]["onFailure"] = "block"
    wanted = {e: g for e, g in all_events.items() if not only or e in only}
    if hook_arg.endswith("--harness cursor"):
        return {CURSOR_EVENT[e]: cursor_entry(e, g) for e, g in wanted.items()}
    return wanted


# Cursor's hooks.json names its events in camelCase and takes one flat entry
# per hook, with the matcher and timeout on the entry itself.
CURSOR_EVENT = {"SessionStart": "sessionStart", "PreToolUse": "preToolUse",
                "PostToolUse": "postToolUse", "PostToolUseFailure": "postToolUseFailure"}


def cursor_entry(event, group):
    entry = {k: v for k, v in group["hooks"][0].items() if k in ("command", "timeout")}
    if "matcher" in group:
        entry["matcher"] = group["matcher"]
    if event == "PreToolUse":
        # Cursor runs the tool when a hook crashes, times out or prints nothing,
        # unless the entry says otherwise.
        entry["failClosed"] = True
    return entry


def claude_event(event):
    """The name REQUIRED_ENV and the timeout check know an event by."""
    return event[:1].upper() + event[1:]


def hooks_of(group):
    """The hook entries in one group: Claude Code nests them, Cursor's group is one."""
    if not isinstance(group, dict):
        return []
    return group["hooks"] if isinstance(group.get("hooks"), list) else (
        [group] if "command" in group else [])


def load(path):
    if not os.path.exists(path):
        return {}
    with open(path) as f:
        text = f.read().strip()
    if not text:
        return {}
    try:
        return json.loads(text)
    except json.JSONDecodeError as e:
        sys.exit(f"stratium: {path} is not valid JSON ({e}); refusing to overwrite it")


def save(path, settings, dry_run):
    body = json.dumps(settings, indent=2) + "\n"
    if dry_run:
        print(f"--- would write {path} ---\n{body}", end="")
        return
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    # Write-then-rename: a crash mid-write must not leave a truncated settings
    # file, which Claude Code would reject on next launch.
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)))
    try:
        with os.fdopen(fd, "w") as f:
            f.write(body)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def strip(settings, events=None):
    """Remove Stratium entries, pruning containers left empty. Returns count.

    `events` limits the sweep to those event names; None means all of them.
    """
    removed = 0
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return 0
    for event in list(hooks):
        if events is not None and event not in events:
            continue
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        kept_groups = []
        for group in groups:
            inner = hooks_of(group)
            kept = [h for h in inner if not ours(h)]
            removed += len(inner) - len(kept)
            if inner and not kept:
                continue  # the whole group was ours
            if kept and kept[0] is not group:
                group["hooks"] = kept
            kept_groups.append(group)
        if kept_groups:
            hooks[event] = kept_groups
        else:
            del hooks[event]
    if not hooks:
        del settings["hooks"]
        if set(settings) == {"version"}:
            del settings["version"]  # Cursor's file, with nothing left in it
    return removed


def resolves(binary):
    """Is `binary` actually runnable? A path is checked as one, a bare name on PATH."""
    word = binary.split()[0] if binary.split() else binary
    if os.sep in word:
        return os.path.isfile(word) and os.access(word, os.X_OK)
    return shutil.which(word) is not None


def install(args):
    if getattr(args, "system", False):
        return install_system(args)
    if args.harness == "opencode":
        return install_opencode(args)
    if not args.force and not resolves(args.bin):
        # Refusing rather than warning, because the failure is fail-open, not
        # broken: a PreToolUse hook whose command is missing exits 127, and
        # Claude Code lets the tool call through on any non-zero that is not 2.
        # You would see a hook error in the transcript and no enforcement at all.
        sys.exit(f"stratium: {args.bin!r} is not runnable "
                 f"({'no such executable' if os.sep in args.bin else 'not on PATH'}). "
                 "A PreToolUse hook that cannot run exits 127, which Claude Code treats "
                 "as a non-blocking error — the tool call proceeds unchecked. Pass "
                 "--bin with a real path (the test plan builds /tmp/stratium-pep), or "
                 "--force if you are writing settings for another machine.")
    if not ours({"command": args.bin}):
        print(f"warning: {args.bin!r} matches none of {MARKERS} — `uninstall` and "
              "`status` find entries by name, so they will not see this one. "
              "Remove it by hand if you install it.", file=sys.stderr)
    settings = load(args.settings)
    wanted = entries(args.bin, args.matcher, args.only, HARNESS[args.harness]["hook_arg"])
    # Strip only the events we are about to write, so `install --only PreToolUse`
    # does not silently remove a SessionStart hook installed by an earlier run.
    replaced = strip(settings, events=set(wanted))
    if args.harness == "cursor":
        settings.setdefault("version", 1)
    hooks = settings.setdefault("hooks", {})
    for event, group in wanted.items():
        hooks.setdefault(event, []).append(group)
    save(args.settings, settings, args.dry_run)
    verb = "reinstalled" if replaced else "installed"
    print(f"{verb} {' + '.join(wanted)} (matcher {args.matcher!r}, command {args.bin!r}) in {args.settings}")
    if getattr(args, "show_next", True):
        next_steps([claude_event(e) for e in wanted], args.harness, args.bin)


