def sh(cmd, check=True, **kw):
    r = subprocess.run(cmd, text=True, capture_output=True, **kw)
    if check and r.returncode != 0:
        raise Fail((r.stderr or r.stdout or f"{cmd[0]} exited {r.returncode}").strip())
    return (r.stdout or "").strip()


def compose(*args, **kw):
    return sh(["docker", "compose", "-f", COMPOSE, *args], **kw)


def compose_project():
    """The compose project these commands act on.

    Docker derives it from the compose file's parent directory unless
    COMPOSE_PROJECT_NAME says otherwise -- and that directory is `docker` here,
    which is not distinctive. Two checkouts, or a stray COMPOSE_PROJECT_NAME in
    the environment, resolve to the same or a surprising project, and `down -v`
    destroys volumes. So `up` records what it created and `down` refuses to tear
    down anything else.
    """
    try:
        return json.loads(compose("config", "--format", "json"))["name"]
    except (Fail, ValueError, KeyError):
        return os.environ.get("COMPOSE_PROJECT_NAME") or "?"


def port(service, internal):
    """Resolve a published port. Never cached — it changes on every compose up."""
    out = compose("port", service, str(internal))
    if ":" not in out:
        raise Fail(f"{service} has no published port for {internal} (is the stack up?)")
    return "localhost:" + out.rsplit(":", 1)[1]


def token(role):
    """Mint a fresh operator token. Called per request, because they die in 5m."""
    user, password = OPERATORS[role]
    body = urllib.parse.urlencode({
        "grant_type": "password", "client_id": "stratium-pap",
        "username": user, "password": password, "scope": "openid email",
    }).encode()
    url = "http://%s/realms/stratium/protocol/openid-connect/token" % port("keycloak", 8080)
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=body), timeout=10) as r:
            return json.load(r)["access_token"]
    except urllib.error.URLError as e:
        raise Fail(f"could not mint a {role} token from keycloak: {e}")


def api(method, path, role="editor", body=None):
    """Call the PAP. Returns (status, parsed-or-text) — errors are text, not JSON."""
    url = "http://%s%s" % (port("stratium-pap", 8080), path)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={
        "Authorization": "Bearer " + token(role),
        "Content-Type": "application/json",
    })
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            raw = r.read().decode().strip()
            return r.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as e:
        raw = e.read().decode().strip()
        try:
            return e.code, json.loads(raw)
        except ValueError:
            return e.code, raw          # 401 is the bare word `unauthorized`
    except urllib.error.URLError as e:
        raise Fail(f"could not reach the PAP: {e}")


def psql(sql, owner=True):
    pw = "stratium_migrate_local_dev_only" if owner else "stratium_local_dev_only"
    user = "stratium_migrate" if owner else "stratium"
    return compose("exec", "-T", "-e", "PGPASSWORD=" + pw, "postgres",
                   "psql", "-h", "127.0.0.1", "-U", user, "-d", "stratium", "-tAc",
                   "SELECT set_config('app.tenant_id','%s',false); %s" % (TENANT, sql))


def load_state():
    if not os.path.exists(STATE_PATH):
        return {}
    try:
        return json.loads(open(STATE_PATH).read() or "{}")
    except json.JSONDecodeError:
        return {}


def save_state(**kw):
    state = load_state()
    state.update(kw)
    # Addresses and tokens are deliberately never persisted; see the docstring.
    for banned in ("pdp_addr", "pap_addr", "kc_addr", "token"):
        state.pop(banned, None)
    with open(STATE_PATH, "w") as f:
        json.dump(state, f, indent=2)
        f.write("\n")
    return state


def pep_env(state):
    """The ten variables, built fresh. Ports resolved now, not remembered."""
    env = dict(os.environ)
    env.update({
        "STRATIUM_PEP_PDP_ADDR": port("pdp-pap", 50051),
        "STRATIUM_PEP_AGENT_ID": state["agent_id"],
        "STRATIUM_PEP_SUBJECT": SUBJECT,
        "STRATIUM_PEP_SESSION_FILE": state["session_file"],
        "STRATIUM_PEP_CONNECT_TIMEOUT": "5s",
        "STRATIUM_PEP_APPROVAL_POLL_INTERVAL": "2s",
        "STRATIUM_PEP_APPROVAL_TIMEOUT": "120s",
        "STRATIUM_PEP_REQUESTED_TOOLS": state.get("tools", DEMO_TOOLS),
        "STRATIUM_PEP_REQUESTED_TIER": str(DEMO_TIER),
        "STRATIUM_PEP_TTL_SECONDS": str(DEMO_TTL),
        "STRATIUM_PEP_PURPOSE": "stratium quickstart",
        # The compose stack's PDPs serve plaintext (STRATIUM_GRPC_INSECURE);
        # the PEP defaults to TLS, so it has to be told.
        "STRATIUM_PEP_PDP_INSECURE": "true",
    })
    return env


def hook_scopes():
    """Every file Claude Code and Codex merge hooks from.

    `status` reports on ONE file, which reads as a global all-clear and is not.
    doctor walks all of them: a hook hiding in a scope you did not check denies
    every tool call in every project, and the clean report from the file you did
    check is exactly what stops you finding it.
    """
    return [
        ("claude managed", MANAGED_SETTINGS),
        ("claude project", os.path.join(REPO, ".claude", "settings.json")),
        ("claude project-local", os.path.join(REPO, ".claude", "settings.local.json")),
        ("claude user", os.path.expanduser("~/.claude/settings.json")),
        ("codex user", os.path.expanduser("~/.codex/hooks.json")),
    ]


def scan_hooks():
    """Every Stratium hook entry across every scope: (scope, path, event, command, timeout)."""
    found = []
    for label, path in hook_scopes():
        if not os.path.exists(path):
            continue
        try:
            settings = json.loads(open(path).read() or "{}")
        except json.JSONDecodeError:
            found.append((label, path, "UNREADABLE", None, None))
            continue
        for event, groups in (settings.get("hooks") or {}).items():
            if not isinstance(groups, list):
                continue
            for group in groups:
                for h in (group.get("hooks", []) if isinstance(group, dict) else []):
                    if ours(h):
                        found.append((label, path, event, h.get("command"), h.get("timeout")))
    return found


def hook_probe(state, tool, resource):
    """Run one PreToolUse decision through the real binary. Returns (rc, reason)."""
    payload = json.dumps({"tool_name": tool, "tool_input": {
        "file_path": resource, "path": resource,
        "command": "echo hi", "url": "https://example.com"}})
    r = subprocess.run([PEP_BIN, "hook"], input=payload, text=True,
                       capture_output=True, env=pep_env(state))
    out = (r.stdout or "").strip()
    reason = ""
    if out:
        try:
            reason = json.loads(out)["hookSpecificOutput"]["permissionDecisionReason"]
        except Exception:
            reason = out
    return r.returncode, reason or (r.stderr or "").strip()


# ------------------------------------------------------------------- the verbs

STEP = [0]


def step(title):
    STEP[0] += 1
    print(f"\n[{STEP[0]}] {title}")


def ok(msg):
    print(f"    ok   {msg}")


def note(msg):
    print(f"         {msg}")


def harness_path(harness, user=False):
    """Absolute settings path for a harness, anchored to THIS repo.

    HARNESS's project path is relative, which resolves against the caller's cwd.
    Anchoring to REPO keeps `up` and `down` acting on the same file no matter
    where either was invoked from.
    """
    raw = HARNESS[harness]["user_path" if user else "path"]
    return os.path.expanduser(raw) if raw.startswith("~") else os.path.join(REPO, raw)


def hook_args(harness, binary, only=None, dry_run=False):
    """A Namespace shaped the way install()/uninstall()/status() expect."""
    h = HARNESS[harness]
    return argparse.Namespace(
        harness=harness, bin=binary, matcher="*", only=only or list(h["events"]),
        settings=harness_path(harness, user=(harness == "codex")),
        dry_run=dry_run, force=False, user=False,
        # `up` ends on the launcher, which supersedes the by-hand export block
        show_next=False)


def in_agent_session():
    """Are we running inside an agent session that our own hooks would gag?

    Claude Code exports CLAUDECODE=1 to everything it spawns, so a quickstart run
    from its Bash tool sees it. Codex sets CODEX_SANDBOX / CODEX_HOME.

    The environment alone is not enough. A subagent's shell need not inherit
    those variables, and one that does not will sail past this guard, wire a
    matcher:"*" hook, and gag the PARENT session it was spawned from -- observed,
    twice. So fall back to walking the process ancestry: if an agent binary is
    anywhere above us, installing is unsafe no matter what the environment says.
    """
    if os.environ.get("CLAUDECODE"):
        return "claude"
    if os.environ.get("CODEX_SANDBOX") or os.environ.get("CODEX_HOME"):
        return "codex"
    return _agent_in_ancestry()


def _agent_in_ancestry(max_depth=12):
    """Walk up the parent chain looking for an agent process. Best-effort.

    `ps` is asked one pid at a time rather than parsed wholesale so a weird
    comm field cannot desync the walk. Any failure returns None: this is a
    safety net, and a net that errors must not become a blocker.
    """
    try:
        pid = os.getppid()
        for _ in range(max_depth):
            if pid <= 1:
                return None
            out = subprocess.run(["ps", "-o", "comm=,ppid=", "-p", str(pid)],
                                 capture_output=True, text=True)
            if out.returncode != 0 or not out.stdout.strip():
                return None
            parts = out.stdout.split()
            comm, pid = os.path.basename(parts[0]), int(parts[-1])
            if comm == "claude":
                return "claude"
            if comm == "codex":
                return "codex"
    except Exception:
        return None
    return None


def preflight():
    missing = [t for t in ("docker", "go") if not shutil.which(t)]
    if missing:
        raise Fail("missing on PATH: " + ", ".join(missing) +
                   " -- docker runs the stack, go builds stratium-pep")
    if not os.path.exists(COMPOSE):
        raise Fail(f"no compose file at {COMPOSE}; run this from the repo")
    if subprocess.run(["docker", "compose", "version"], capture_output=True).returncode:
        raise Fail("`docker compose` is not available (v1 `docker-compose` will not do)")


def ensure_stack():
    compose("up", "-d", "--build", "--wait", "--wait-timeout", "300")


def ensure_binary():
    os.makedirs(BIN_DIR, exist_ok=True)
    sh(["go", "build", "-o", PEP_BIN, "./cmd/stratium-pep"],
       cwd=os.path.join(REPO, "services"))
    if not resolves(PEP_BIN):
        raise Fail(f"built {PEP_BIN} but it is not executable")


def ensure_policy():
    """0b: without a policy naming the principal, CreateDelegation refuses.

    The effect column must be "deny" even for a policy that allows: a Rego policy
    can produce either outcome per request, so the column holds a fixed
    placeholder rather than a claim about behaviour. Sending "allow" is a 400.
    """
    rego = ('package stratium.policy\n\nallow if {\n\tinput.principal.subject == "%s"\n}'
            % SUBJECT)
    code, body = api("POST", "/v1/policies", body={
        "name": "stratium-quickstart-grant",
        "description": "quickstart: let the demo principal hold tools",
        "language": "rego", "effect": "deny", "enabled": True,
        "policy_content": rego})
    if code == 201:
        return "created"
    if code == 409:
        return "already present"
    raise Fail(f"policy POST returned {code}: {body}")


def ensure_catalog():
    before = int(psql("SELECT count(*) FROM tool_catalog;").splitlines()[-1] or 0)
    for seed in ("tool-catalog-claude-code.sql", "tool-catalog-mcp-filesystem.sql"):
        path = os.path.join(REPO, "deploy", "seed", seed)
        if not os.path.exists(path):
            raise Fail(f"missing seed {path}")
        with open(path) as f:
            subprocess.run(
                ["docker", "compose", "-f", COMPOSE, "exec", "-T",
                 "-e", "PGPASSWORD=stratium_migrate_local_dev_only", "postgres",
                 "psql", "-h", "127.0.0.1", "-U", "stratium_migrate", "-d", "stratium",
                 "-v", f"tenant_id={TENANT}", "-q", "-f", "/dev/stdin"],
                stdin=f, capture_output=True, text=True)
    after = int(psql("SELECT count(*) FROM tool_catalog;").splitlines()[-1] or 0)
    return before, after


def ensure_agent(state):
    """Reuse the agent from a previous run if it still exists, else make one.

    Names carry a uuid suffix: UNIQUE (tenant_id, name) turns a fixed name into a
    409 on the second run, and nothing downstream reads the name anyway.
    """
    if state.get("agent_id"):
        code, _ = api("GET", "/v1/agents/" + state["agent_id"], role="viewer")
        if code == 200:
            return state["agent_id"], state.get("agent_name", "?"), "reused"
    name = "quickstart-" + uuid.uuid4().hex[:6]
    code, body = api("POST", "/v1/agents", body={
        "name": name, "provider": "anthropic", "model_id": "claude",
        "trust_tier": DEMO_TIER, "enabled": True, "suspended": False,
        "allowed_tools": []})
    if code != 201:
        raise Fail(f"agent POST returned {code}: {body}")
    return body["id"], name, "created"


def ensure_label_rule(prefix, hierarchy, level):
    """POST one resource-label-rule. Idempotent like ensure_policy: a rerun
    hits UNIQUE (tenant_id, prefix) and 409s rather than erroring.
    """
    code, body = api("POST", "/v1/resource-label-rules", body={
        "prefix": prefix, "hierarchy": hierarchy, "level": level})
    if code == 201:
        return "created"
    if code == 409:
        return "already present"
    raise Fail(f"resource-label-rules POST {prefix!r} returned {code}: {body}")


def ensure_caps(agent_id):
    """PUT Task 7's route (RoleAdmin): the ceiling verify's classification
    case needs. Requires the catch-all rule to exist first -- without one,
    SetAgentClassificationCaps refuses an uncovered hierarchy -- so this must
    run after ensure_label_rule(*CATCH_ALL_RULE). A PUT is a full replace, so
    calling it again on a reused agent just re-asserts the same caps.
    """
    code, body = api("PUT", f"/v1/agents/{agent_id}/classification-caps",
                     role="admin", body={"classification_caps": DEMO_CAPS})
    if code != 200:
        raise Fail(f"classification-caps PUT returned {code}: {body}")
    return body


def start_session(state):
    r = subprocess.run([PEP_BIN, "session-start"], capture_output=True, text=True,
                       env=pep_env(state))
    if r.returncode != 0:
        raise Fail("session-start failed: " + (r.stderr or r.stdout).strip())
    with open(state["session_file"]) as f:
        return json.load(f)


def cmd_up(args):
    started = time.time()
    harnesses = {"claude": ["claude"], "codex": ["codex"],
                 "both": ["claude", "codex"]}[args.harness]

    step("Preflight")
    preflight()
    ok("docker, docker compose and go are present")

    step("Stack up (this is the slow one -- it builds images)")
    ensure_stack()
    project = compose_project()
    ok(f"compose project: {project}")
    ok(f"pap={port('stratium-pap', 8080)}  pdp={port('pdp-pap', 50051)}  "
       f"kc={port('keycloak', 8080)}")
    note("resolved now, never stored -- they change on every compose up")

    step("Build the PEP")
    ensure_binary()
    ok(PEP_BIN)

    step("Policy so the principal may delegate")
    ok(ensure_policy() + f" (subject {SUBJECT})")

    step("Seed the tool catalog")
    before, after = ensure_catalog()
    ok(f"tool_catalog rows: {before} -> {after}")

    step("Agent row")
    state = load_state()
    state.setdefault("session_file", os.path.join(REPO, ".stratium-session.json"))
    state["tools"] = DEMO_TOOLS
    agent_id, agent_name, how = ensure_agent(state)
    state = save_state(agent_id=agent_id, agent_name=agent_name,
                       session_file=state["session_file"], tools=DEMO_TOOLS,
                       project=project)
    ok(f"{how}: {agent_name} ({agent_id})")

    step("Classification caps")
    ok(ensure_label_rule(*CATCH_ALL_RULE) + " (catch-all, so every other probe stays UNCLASSIFIED)")
    for rule in SECRET_RULES:
        ok(ensure_label_rule(*rule) + f' ("{rule[0]}*" -> SECRET)')
    ensure_caps(agent_id)
    state = save_state(caps=DEMO_CAPS)
    ok(f"{agent_name} capped at {DEMO_CAPS}")
    note("verify's classification case needs this; state['caps'] is how it knows")

    step("Delegation")
    session = start_session(state)
    ok(f"{session['delegation_id']}  grants {','.join(session['granted_scope']['tools'])}"
       f"  tier {session['granted_scope']['max_action_tier']}")

    step("Wire the hooks")
    inside = in_agent_session()
    if inside and not args.wire_anyway:
        # Refusing rather than warning. A matcher:"*" hook takes effect in the
        # running session immediately, and that session was not launched with the
        # ten variables -- so every tool call denies, including the ones you
        # would use to undo it. Everything above this line is already done.
        note(f"SKIPPED -- this is running inside a {inside} session.")
        note("Installing now would deny every tool call in it, including the ones")
        note("you would need to recover: the session picks the hook up live, but it")
        note("was not launched with the environment the hook reads.")
        note("")
        note("Finish from a plain terminal:")
        note(f"    deploy/stratium install --{inside} --bin {PEP_BIN}")
        note(f"    deploy/stratium run {inside}")
        note("")
        note("Or re-run with --wire-anyway if you meant to disable this session.")
        save_state(harnesses=harnesses)
        step("Verify -- onboarding is not done until a denial is observed")
        rc = cmd_verify(argparse.Namespace(harness=None))
        print(f"\nStack, agent and delegation are ready in {int(time.time() - started)}s;"
              f"\nhooks are not wired. The two commands above finish it.")
        return rc
    for harness in harnesses:
        install(hook_args(harness, PEP_BIN))
    save_state(harnesses=harnesses)

    step("Verify -- onboarding is not done until a denial is observed")
    rc = cmd_verify(argparse.Namespace(harness=None))
    if rc:
        raise Fail("verification failed; the stack is up but enforcement is not proven")

    print(f"\nReady in {int(time.time() - started)}s. Launch an agent with:\n")
    for harness in harnesses:
        print(f"    deploy/stratium run {harness}")
    print("\nThat launcher sets the environment the hooks read. Starting the agent\n"
          "any other way leaves it denying every tool call for want of config.")
    return 0


def cmd_verify(args):
    """Observe real decisions and assert on them. No model in the loop."""
    state = load_state()
    if not state.get("agent_id"):
        raise Fail("no state -- run `deploy/stratium up` first")
    if not resolves(PEP_BIN):
        raise Fail(f"{PEP_BIN} is not there -- run `deploy/stratium up` first")

    tag = uuid.uuid4().hex[:8]   # fresh resource each run
    cases = [
        # (tool, want exit, label, reason substring to require -- None skips that check)
        ("Read", 0, "granted -- must be allowed", None),
        # LS, not Write. The integration suites write tier_overrides rows
        # against this same shared tenant and do not clean them up; a
        # standing Write->DESTRUCTIVE row once made this probe deny on
        # ACTION TIER rather than tool-holding -- green, but for a reason
        # its label did not claim. That row has been deleted, and a later
        # integration run will put it back. LS is a probe the residue
        # cannot reach: catalogued at READ_ONLY (deploy/seed/tool-catalog-
        # claude-code.sql), well under this delegation's EXTERNAL_COMMS
        # ceiling and carries no override, so a denial here can only come
        # from HasTool -- the thing this case's label actually claims.
        ("LS", 2, "catalogued, held tool not in the grant -- must be denied",
         "not in delegation approved_tools"),
        ("Frobnicate" + tag, 2, "not even catalogued -- must be denied", None),
    ]
    print(f"delegation grants {state.get('tools', DEMO_TOOLS)}\n")
    failures = []
    for tool, want, why, want_reason in cases:
        rc, reason = hook_probe(state, tool, f"/quickstart-{tag}/probe.txt")
        good = rc == want and (want_reason is None or want_reason in reason)
        failures.append(None if good else (tool, want, rc))
        print(f"  {'PASS' if good else 'FAIL'}  {tool:<18} exit={rc} (want {want})  {why}")
        if reason:
            print(f"        {reason[:150]}")

    if "codex" in state.get("harnesses", []):
        print("\nas Codex runs it (--harness codex):")
        for tool, want, _, _ in cases:
            payload = json.dumps({"tool_name": tool, "tool_input": {
                "file_path": f"/quickstart-{tag}/probe.txt"}})
            r = subprocess.run([PEP_BIN, "hook", "--harness", "codex"], input=payload, text=True,
                               capture_output=True, env=pep_env(state))
            good = r.returncode == want
            failures.append(None if good else ("codex:" + tool, want, r.returncode))
            print(f"  {'PASS' if good else 'FAIL'}  {tool:<18} exit={r.returncode} "
                  f"(want {want})  reason on stderr: {bool(r.stderr.strip())}")
        note("the live-session leg is unverified -- see 2f of the agent test plan")

    # Classification is now reachable through the API, so verify proves it
    # rather than printing a disclaimer. Requires a catch-all rule and a cap;
    # cmd_up sets both and records it in state["caps"] -- absent (an older
    # `up` ran before this existed), the case is skipped rather than failing
    # on a precondition verify itself did not set up.
    if state.get("caps"):
        rc, reason = hook_probe(state, "Read", f"/secret-{tag}/plans.txt")
        good = rc == 2 and "exceeds delegation cap" in reason
        failures.append(None if good else ("classification", 2, rc))
        print(f"  {'PASS' if good else 'FAIL'}  {'classification':<18} exit={rc} (want 2)  "
              f"SECRET over a CONFIDENTIAL cap")
        print(f"        {reason[:150]}")

    bad = [f for f in failures if f]
    if bad:
        print("\n%d assertion(s) failed: %s" % (len(bad), bad))
        return 1
    print("\nEnforcement proven: a held tool allowed, an unheld tool denied.")
    return 0


def cmd_run(args):
    """Resolve everything fresh, then become the agent."""
    state = load_state()
    if not state.get("agent_id"):
        raise Fail("no state -- run `deploy/stratium up` first")
    binary = shutil.which(args.agent)
    if not binary:
        raise Fail(f"{args.agent} is not on PATH")
    env = pep_env(state)
    print(f"launching {args.agent} with {len(REQUIRED_ENV['SessionStart']) } + "
          f"{len(REQUIRED_ENV['PreToolUse'])} variables resolved at "
          f"{env['STRATIUM_PEP_PDP_ADDR']}", file=sys.stderr)
    os.execve(binary, [args.agent] + list(args.rest), env)


def cmd_doctor(args):
    """Walk the layers in dependency order; stop being green at the first break."""
    problems = 0

    def line(state, label, msg, fix=None):
        nonlocal problems
        print(f"  {state}  {label:<12} {msg}")
        if fix:
            print(f"     -> {fix}")
            problems += 1

    try:
        preflight()
        line("OK", "toolchain", "docker, docker compose, go")
    except Fail as e:
        line("XX", "toolchain", str(e), "install what is missing")
        return 1

    try:
        running = compose("ps", "--services", "--filter", "status=running").splitlines()
        if running:
            line("OK", "stack", f"{len(running)} services running")
        else:
            line("XX", "stack", "nothing running", "deploy/stratium up --harness claude")
            return 1
        line("OK", "ports", f"pap={port('stratium-pap', 8080)} pdp={port('pdp-pap', 50051)}")
    except Fail as e:
        line("XX", "stack", str(e), "deploy/stratium up --harness claude")
        return 1

    state = load_state()
    if state.get("agent_id"):
        line("OK", "state", f"{state.get('agent_name')} ({state['agent_id']})")
    else:
        line("XX", "state", "no .stratium-quickstart.json",
             "deploy/stratium up --harness claude")

    line("OK" if resolves(PEP_BIN) else "XX", "binary",
         PEP_BIN if resolves(PEP_BIN) else PEP_BIN + " missing or not executable",
         None if resolves(PEP_BIN) else "deploy/stratium up --harness claude")

    found = scan_hooks()
    if not found:
        line("--", "hooks", "none in any scope")
        print("     note: install and uninstall both take effect in a running session,\n"
              "           observed. If a session still denies with clean scopes here,\n"
              "           the hook is defined somewhere this list does not cover --\n"
              "           check `/hooks` inside that session, then restart it.")
    exposed_any = False
    for scope, path, event, command, timeout in found:
        runnable = command and resolves(command)
        line("OK" if runnable else "XX", "hooks",
             f"{scope:<20} {event:<12} {command}",
             None if runnable else f"that command does not resolve; re-run install "
                                   f"with --bin {PEP_BIN}")
        if timeout_too_short(event, timeout, hook_env(command)):
            line("XX", "hooks", f"{scope:<20} timeout {timeout} is below "
                                f"{hook_timeout(hook_env(command))}",
                 TIMEOUT_FIX)
        for what, hit in [("hook entry", writable_here(path))] + exposed(command):
            if hit:
                print(f"!!  {'hooks':<12} {scope:<20} {what} writable by you: {hit}")
                exposed_any = True
    if exposed_any:
        print(f"     note: {EXPOSED_FIX}")

    if state.get("agent_id"):
        gone = [v for v in sorted(set(REQUIRED_ENV["SessionStart"]) |
                                  set(REQUIRED_ENV["PreToolUse"]))
                if not os.environ.get(v)]
        if gone:
            line("XX", "environment", f"{len(gone)} of 11 missing in this shell",
                 "you are outside the launcher -- use: deploy/stratium run claude")
        else:
            line("OK", "environment", "all 11 set here")

    if state.get("session_file") and os.path.exists(state["session_file"]):
        with open(state["session_file"]) as f:
            s = json.load(f)
        line("OK", "delegation", f"{s['delegation_id']} grants "
                                 f"{','.join(s['granted_scope']['tools'])}")
        caps = psql("SELECT classification_caps FROM delegations WHERE id='%s';"
                    % s["delegation_id"]).splitlines()[-1]
        line("!!" if caps in ("{}", "") else "OK", "caps",
             f"{caps or '(none)'} -- classification enforcement is "
             f"{'OFF (expected, see verify)' if caps in ('{}', '') else 'on'}")
    else:
        line("XX", "delegation", "no session file",
             "deploy/stratium up --harness claude")

    print()
    return 1 if problems else 0


def cmd_down(args):
    """Order matters: hooks first, stack second.

    Reverse it and every tool call in an open agent session denies against a PDP
    that is no longer listening, and the session cannot recover without a restart.
    """
    step("Unwire the hooks (before the stack, deliberately)")
    for scope, path, event, command, _timeout in scan_hooks():
        note(f"{scope}: {event} {command}")
    for harness in ("claude", "codex"):
        for scope_path in {harness_path(harness), harness_path(harness, user=True)}:
            a = hook_args(harness, PEP_BIN)
            a.settings = scope_path
            if os.path.exists(scope_path):
                uninstall(a)
    note("an agent session already open keeps the hooks it read at startup -- "
         "restart it, or it will deny every call once the stack is down")

    step("Stack down")
    project, recorded = compose_project(), load_state().get("project")
    if recorded and project != recorded and not getattr(args, "force", False):
        raise Fail(
            f"this would tear down compose project {project!r} with -v (volumes and "
            f"all), but `up` created {recorded!r}. Refusing. You are probably in the "
            f"wrong directory, or COMPOSE_PROJECT_NAME is set. Pass --force if you "
            f"really mean {project!r}.")
    if not recorded:
        note(f"no recorded project; acting on {project!r} as docker resolves it")
    compose("down", "-v", "--remove-orphans")
    ok(f"project {project}: containers and volumes gone")

    step("Local artefacts")
    for path in (STATE_PATH, PEP_BIN, SHIM_BIN, os.path.join(REPO, ".stratium-session.json")):
        if os.path.exists(path):
            os.unlink(path)
            ok("removed " + path)
    return 0


def add_options(p, suppress=False):
    """Add the shared options to `p`.

    They go on the top-level parser *and* on every subparser, so both
    `--claude install` and `install --claude` work — argparse subparsers do not
    inherit their parent's options, and having them accepted in only one
    position is a trap. On the subparsers the defaults are SUPPRESS: without
    that, a subparser's unspecified default would overwrite the value the
    top-level parser already parsed, and `--bin X install` would silently lose X.
    """
    def d(value):
        return argparse.SUPPRESS if suppress else value

    # No default harness, deliberately. The two write different files with
    # different failure modes — picking one for you is how you end up enforcing
    # on the harness you were not running.
    harness = p.add_mutually_exclusive_group()
    harness.add_argument("--claude", dest="harness", action="store_const", const="claude",
                         default=d(None),
                         help="target Claude Code: .claude/settings.json, SessionStart + PreToolUse")
    harness.add_argument("--codex", dest="harness", action="store_const", const="codex",
                         default=d(None),
                         help="target Codex: ~/.codex/hooks.json, SessionStart + PreToolUse + PostToolUse")
    harness.add_argument("--cursor", dest="harness", action="store_const", const="cursor",
                         default=d(None),
                         help="target Cursor (app and CLI): ~/.cursor/hooks.json")
    harness.add_argument("--opencode", dest="harness", action="store_const", const="opencode",
                         default=d(None),
                         help="target OpenCode 2.x: a plugin in ~/.config/opencode")
    p.add_argument("--settings", default=d(None),
                   help="the file to edit (default: the harness's own, see --claude/--codex)")
    p.add_argument("--user", action="store_true", default=d(False),
                   help="use the user-scope file rather than the project one (Claude Code; "
                        "Codex is user-scope either way)")
    p.add_argument("--bin", default=d(None),
                   help="the hook binary (default: stratium-pep; the test plan builds "
                        "/tmp/stratium-pep)")
    p.add_argument("--matcher", default=d("*"),
                   help="PreToolUse matcher (default: *; 'Read' to start narrow)")
    p.add_argument("--only", action="append",
                   choices=["SessionStart", "PreToolUse", "PostToolUse", "PostToolUseFailure"],
                   default=d(None),
                   help="install just this event, repeatable (default: every event the "
                        "harness wires). Use --only PreToolUse when a delegation already "
                        "exists and a SessionStart hook would replace it")
    p.add_argument("--system", action="store_true", default=d(False),
                   help="install, uninstall or report on the administrator's install: a "
                        f"root-owned binary ({SYSTEM_BIN}), configuration ({SYSTEM_CONF}) "
                        "and managed hook entry (Claude Code managed settings, or "
                        f"{CODEX_REQUIREMENTS} for Codex), none of which the agent's "
                        "own user can change. Needs sudo -E")
    p.add_argument("--system-root", default=d("/"), help=argparse.SUPPRESS)
    p.add_argument("-n", "--dry-run", action="store_true", default=d(False),
                   help="print the result, write nothing")
    p.add_argument("--force", action="store_true", default=d(False),
                   help="install even if --bin does not resolve here (for settings you are "
                        "writing on one machine and running on another)")


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    add_options(p)
    sub = p.add_subparsers(dest="cmd", required=True)

    for name, fn in (("install", install), ("uninstall", uninstall),
                     ("status", status), ("selftest", selftest)):
        sp = sub.add_parser(name, help=(fn.__doc__ or "").strip().splitlines()[0]
                            if fn.__doc__ else name)
        add_options(sp, suppress=True)
        sp.set_defaults(fn=fn, needs_harness=fn is not selftest)

    up = sub.add_parser("up", help="zero to an enforcing agent")
    up.add_argument("--harness", required=True, choices=["claude", "codex", "both"],
                    help="which agent to wire -- required, there is no default: a hook "
                         "installed on the harness you are not running is no enforcement")
    up.add_argument("--wire-anyway", action="store_true",
                    help="install hooks even when running inside an agent session -- "
                         "that session will deny every tool call from then on")
    up.set_defaults(fn=cmd_up, needs_harness=False)

    run = sub.add_parser("run", help="launch an agent with the environment set")
    run.add_argument("agent", choices=["claude", "codex"])
    run.add_argument("rest", nargs=argparse.REMAINDER)
    run.set_defaults(fn=cmd_run, needs_harness=False)

    for name, fn, help_ in (("verify", cmd_verify, "observe a denial, assert on it"),
                            ("doctor", cmd_doctor, "diagnose a break, name the fix"),
                            ("down", cmd_down, "tear down, hooks first")):
        sp = sub.add_parser(name, help=help_)
        if name == "down":
            sp.add_argument("--force", action="store_true",
                            help="tear down even if the compose project is not the one "
                                 "`up` created")
        sp.set_defaults(fn=fn, needs_harness=False)

    args = p.parse_args()
    if getattr(args, "needs_harness", False):
        if args.harness is None:
            p.error("pick a harness: --claude, --codex, --cursor or --opencode")
        resolve(args, p)
    try:
        sys.exit(args.fn(args) or 0)
    except Fail as e:
        sys.exit(f"stratium: {e}")
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
