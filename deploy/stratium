# The cap verify's classification case needs, plus the two label rules that make
# it evaluable. "" is the catch-all every OTHER probe's resource id falls under
# once a cap is set (R7's cliff: a configured cap with no matching rule denies
# everything, not just what you meant to restrict) -- UNCLASSIFIED is comfortably
# under CONFIDENTIAL, so the existing Read/Write/Frobnicate cases keep their
# outcomes. "/secret-" covers verify's own per-run tag (f"/secret-{tag}/...") at
# SECRET, which is over the cap, so that one case denies on classification alone.
DEMO_CAPS = {"nato": "CONFIDENTIAL"}
CATCH_ALL_RULE = ("", "nato", "UNCLASSIFIED")
# Three prefixes, not one. "/secret-" is all verify itself needs -- its probe
# path is synthetic and never touches disk. The other two exist for a HUMAN
# following docs/quickstart.md, who has to create a real file: macOS seals the
# root volume, so `mkdir /secret-demo` fails, and /tmp is writable but does not
# match "/secret-". Both /tmp and /private/tmp are registered because the label
# match is on the literal path string the tool call carries, and macOS resolves
# one to the other -- whichever spelling the agent sends has to hit a rule.
SECRET_RULES = [
    ("/secret-", "nato", "SECRET"),
    ("/tmp/secret-", "nato", "SECRET"),
    ("/private/tmp/secret-", "nato", "SECRET"),
]

