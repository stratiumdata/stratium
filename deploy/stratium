#!/usr/bin/env python3
"""Stratium quickstart -- zero to an enforcing agent, and a way back out.

    deploy/stratium up --harness claude    bring it all up, end on a real denial
    deploy/stratium run claude [args...]   launch an agent with the env set
    deploy/stratium verify                 observe a denial and assert on it
    deploy/stratium doctor                 diagnose a break, name the fix
    deploy/stratium down                   tear down, in the safe order
    deploy/stratium install|uninstall|status    hook wiring only

Standalone from the product: it drives `stratium-pep`, it is not part of it.

One discipline runs through all of it -- PERSIST IDENTITY, NEVER ADDRESSES.
Agent ids and file paths go in .stratium-quickstart.json; ports and tokens never
do. Docker republishes ports on every `compose up` and Keycloak tokens die after
five minutes, so both are resolved fresh per invocation. That is also why `run`
is a launcher rather than a file you source -- a stale value cannot outlive the
process that resolved it.

Hook wiring, inherited from the original stratium-hooks:

--claude (the default) writes the pair documented in docs/pep.md
("`.claude/settings.json`"): SessionStart runs `stratium-pep session-start`
once per session, PreToolUse runs `stratium-pep hook` before every tool call.

--codex writes ~/.codex/hooks.json, and only that file — a project-local Codex
hook is disabled until the project is trusted, which for an enforcement point
is fail-open rather than inert. It wires PreToolUse alone, through the
stratium-codex-hook shim. See Part 2 of
docs/testing/2026-08-20-agent-integration-test.md.

This script only edits the file. The environment variables the hooks read must
be exported in the shell that launches the agent, and `session-start` must have
run — until then every tool call is denied for want of a session.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

# What identifies our entries on the way back out. Both names appear: Claude Code
# runs the binary directly, Codex runs the stratium-codex-hook shim (see HARNESS).
MARKERS = ("stratium-pep", "stratium-codex-hook")


def ours(hook):
    return any(m in str(hook.get("command", "")) for m in MARKERS)

# Timeouts are Claude Code's own hook-execution budget, in seconds, and are
# deliberately larger than STRATIUM_PEP_CONNECT_TIMEOUT so a slow-but-answering
# PDP finishes before Claude Code gives up on the process. See docs/pep.md.
SESSION_START_TIMEOUT = 15
PRE_TOOL_USE_TIMEOUT = 10


# What each hook needs in its environment, per the binary's own loaders. Both
# lists come to eight, but they are NOT the same eight: `hook` wants the two
# approval durations and the cache staleness window, `session-start` wants what
# the delegation is for. Exporting 1a's block satisfies session-start and leaves
# `hook` denying every call. selftest cross-checks these against the Go source.
REQUIRED_ENV = {
    # services/cmd/stratium-pep/session_start.go (STRATIUM_PEP_PURPOSE is optional)
    "SessionStart": (
        "STRATIUM_PEP_PDP_ADDR", "STRATIUM_PEP_AGENT_ID", "STRATIUM_PEP_SUBJECT",
        "STRATIUM_PEP_SESSION_FILE", "STRATIUM_PEP_CONNECT_TIMEOUT",
        "STRATIUM_PEP_REQUESTED_TIER", "STRATIUM_PEP_REQUESTED_TOOLS",
        "STRATIUM_PEP_TTL_SECONDS",
    ),
    # services/cmd/stratium-pep/hook.go, plus cache.go's cacheStalenessWindowEnv
    "PreToolUse": (
        "STRATIUM_PEP_PDP_ADDR", "STRATIUM_PEP_AGENT_ID", "STRATIUM_PEP_SUBJECT",
        "STRATIUM_PEP_SESSION_FILE", "STRATIUM_PEP_CONNECT_TIMEOUT",
        "STRATIUM_PEP_APPROVAL_POLL_INTERVAL", "STRATIUM_PEP_APPROVAL_TIMEOUT",
        "STRATIUM_PEP_CACHE_STALENESS_WINDOW",
    ),
}


# A worked value for each variable, from the agent-integration test plan. The
# first two are per-run: the PDP port is a docker ephemeral port that changes on
# every `compose up`, so it is resolved rather than quoted, and the agent id
# comes from whatever row 0d created.
EXAMPLES = {
    "STRATIUM_PEP_PDP_ADDR": ('"localhost:$(dc port pdp-pap 50051 | sed -E \'s/.*://\')"',
                              "ephemeral — re-resolve after every `compose up`"),
    "STRATIUM_PEP_AGENT_ID": ('"$AGENT"', "the agent row from 0d"),
    "STRATIUM_PEP_SUBJECT": '"agent-tester@example.com"',
    "STRATIUM_PEP_SESSION_FILE": '"/tmp/stratium-session.json"',
    "STRATIUM_PEP_CONNECT_TIMEOUT": "5s",
    "STRATIUM_PEP_REQUESTED_TIER": "3",
    "STRATIUM_PEP_REQUESTED_TOOLS": '"Read,Grep,Glob,Write,Bash"',
    "STRATIUM_PEP_TTL_SECONDS": "3600",
    "STRATIUM_PEP_APPROVAL_POLL_INTERVAL": "2s",
    "STRATIUM_PEP_APPROVAL_TIMEOUT": "120s",
    "STRATIUM_PEP_CACHE_STALENESS_WINDOW": "30s",
}

DC = 'dc() { docker compose -f deploy/docker/docker-compose.yml "$@"; }'


def next_steps(events, agent="claude", binary="stratium-pep"):
    """Print the exports the installed hooks need, and what to run after them.

    Only the ones missing from *this* shell are printed, which is a hint and not
    the truth: the hooks read the environment of whatever shell launches the
    agent. Printing the whole block every time would bury that.
    """
    need = []
    for e in events:
        for v in REQUIRED_ENV.get(e, ()):
            if v not in need:
                need.append(v)
    gone = [v for v in need if not os.environ.get(v)]

    print(f"\nNEXT — the hooks read their configuration from the environment of the "
          f"shell that launches `{agent}`, not from this one.")
    if not gone:
        print(f"All {len(need)} are set here. If you launch `{agent}` from a different "
              "shell, export them there too.")
    else:
        print(f"{len(gone)} of {len(need)} are missing here. In the launching shell:\n")
        if "STRATIUM_PEP_PDP_ADDR" in gone:
            print(f"  {DC}")
        for v in gone:
            spec = EXAMPLES.get(v, '""')
            value, note = spec if isinstance(spec, tuple) else (spec, None)
            line = f"  export {v}={value}"
            if note and len(line) + len(note) + 3 <= 100:
                print(f"{line}{'':<{max(1, 58 - len(line))}}# {note}")
            else:
                if note:
                    print(f"  # {note}")
                print(line)
    if "SessionStart" not in events:
        print(f"\nNo SessionStart hook is installed, so nothing issues a delegation for "
              f"you — run `{binary.split()[0]} session-start` by hand first, or every tool "
              "call denies for want of a session.")
    print(f"\nThen: deploy/stratium --{'codex' if agent == 'codex' else 'claude'} "
          "status   # 0 when the command resolves and the environment is whole")


def missing_env(event):
    return [v for v in REQUIRED_ENV.get(event, ()) if not os.environ.get(v)]


def entries(binary, matcher, only=None, hook_arg="hook"):
    """The two groups to install, in docs/pep.md's shape.

    SessionStart carries no matcher on purpose: it must fire for every session
    source (startup, resume, clear, compact, fork), so a resumed session gets a
    fresh delegation rather than whatever `hook` finds left over.
    """
    all_events = {
        "SessionStart": {
            "hooks": [{
                "type": "command",
                "command": f"{binary} session-start",
                "timeout": SESSION_START_TIMEOUT,
            }],
        },
        "PreToolUse": {
            "matcher": matcher,
            "hooks": [{
                "type": "command",
                "command": f"{binary} {hook_arg}".strip(),
                "timeout": PRE_TOOL_USE_TIMEOUT,
            }],
        },
    }
    return {e: g for e, g in all_events.items() if not only or e in only}


def load(path):
    if not os.path.exists(path):
        return {}
    with open(path) as f:
        text = f.read().strip()
    if not text:
        return {}
    try:
        return json.loads(text)
    except json.JSONDecodeError as e:
        sys.exit(f"stratium: {path} is not valid JSON ({e}); refusing to overwrite it")


def save(path, settings, dry_run):
    body = json.dumps(settings, indent=2) + "\n"
    if dry_run:
        print(f"--- would write {path} ---\n{body}", end="")
        return
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    # Write-then-rename: a crash mid-write must not leave a truncated settings
    # file, which Claude Code would reject on next launch.
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)))
    try:
        with os.fdopen(fd, "w") as f:
            f.write(body)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def strip(settings, events=None):
    """Remove Stratium entries, pruning containers left empty. Returns count.

    `events` limits the sweep to those event names; None means all of them.
    """
    removed = 0
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return 0
    for event in list(hooks):
        if events is not None and event not in events:
            continue
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        kept_groups = []
        for group in groups:
            inner = group.get("hooks", []) if isinstance(group, dict) else []
            kept = [h for h in inner if not ours(h)]
            removed += len(inner) - len(kept)
            if not kept:
                continue  # the whole group was ours
            group["hooks"] = kept
            kept_groups.append(group)
        if kept_groups:
            hooks[event] = kept_groups
        else:
            del hooks[event]
    if not hooks:
        del settings["hooks"]
    return removed


def resolves(binary):
    """Is `binary` actually runnable? A path is checked as one, a bare name on PATH."""
    word = binary.split()[0] if binary.split() else binary
    if os.sep in word:
        return os.path.isfile(word) and os.access(word, os.X_OK)
    return shutil.which(word) is not None


def install(args):
    if not args.force and not resolves(args.bin):
        # Refusing rather than warning, because the failure is fail-open, not
        # broken: a PreToolUse hook whose command is missing exits 127, and
        # Claude Code lets the tool call through on any non-zero that is not 2.
        # You would see a hook error in the transcript and no enforcement at all.
        sys.exit(f"stratium: {args.bin!r} is not runnable "
                 f"({'no such executable' if os.sep in args.bin else 'not on PATH'}). "
                 "A PreToolUse hook that cannot run exits 127, which Claude Code treats "
                 "as a non-blocking error — the tool call proceeds unchecked. Pass "
                 "--bin with a real path (the test plan builds /tmp/stratium-pep), or "
                 "--force if you are writing settings for another machine.")
    if not ours({"command": args.bin}):
        print(f"warning: {args.bin!r} matches none of {MARKERS} — `uninstall` and "
              "`status` find entries by name, so they will not see this one. "
              "Remove it by hand if you install it.", file=sys.stderr)
    settings = load(args.settings)
    wanted = entries(args.bin, args.matcher, args.only, HARNESS[args.harness]["hook_arg"])
    # Strip only the events we are about to write, so `install --only PreToolUse`
    # does not silently remove a SessionStart hook installed by an earlier run.
    replaced = strip(settings, events=set(wanted))
    hooks = settings.setdefault("hooks", {})
    for event, group in wanted.items():
        hooks.setdefault(event, []).append(group)
    save(args.settings, settings, args.dry_run)
    verb = "reinstalled" if replaced else "installed"
    print(f"{verb} {' + '.join(wanted)} (matcher {args.matcher!r}, command {args.bin!r}) in {args.settings}")
    if getattr(args, "show_next", True):
        next_steps(list(wanted), "codex" if args.harness == "codex" else "claude", args.bin)


def uninstall(args):
    settings = load(args.settings)
    removed = strip(settings)
    if not removed:
        print(f"no Stratium hooks in {args.settings}")
        return
    save(args.settings, settings, args.dry_run)
    print(f"removed {removed} Stratium hook(s) from {args.settings}")


def status(args):
    settings = load(args.settings)
    found = [
        (event, h.get("command"), h.get("timeout"), group.get("matcher"))
        for event, groups in (settings.get("hooks") or {}).items()
        if isinstance(groups, list)
        for group in groups
        if isinstance(group, dict)
        for h in group.get("hooks", [])
        if ours(h)
    ]
    if not found:
        print(f"no Stratium hooks in {args.settings}")
        return 1
    incomplete = False
    for event, command, timeout, matcher in found:
        m = "" if matcher is None else f" matcher={matcher!r}"
        print(f"{event}{m} command={command!r} timeout={timeout}")
        runnable = resolves(command)
        gone = missing_env(event)
        if not runnable:
            print(f"  command: NOT RUNNABLE — {command.split()[0]!r} is not there")
        if gone:
            print(f"  env: missing {', '.join(gone)}")
        elif REQUIRED_ENV.get(event):
            print(f"  env: all {len(REQUIRED_ENV[event])} set")
        incomplete = incomplete or gone or not runnable
    if incomplete:
        next_steps([e for e, _, _, _ in found],
                   "codex" if args.harness == "codex" else "claude",
                   found[0][1] or args.bin)
        return 1
    return 0


def selftest(_args):
    """Round-trip the install/uninstall pair over a settings file with a neighbour."""
    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, ".claude", "settings.json")
        os.makedirs(os.path.dirname(path))
        theirs = {
            "model": "opus",
            "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [
                {"type": "command", "command": "my-linter"}]}]},
        }
        with open(path, "w") as f:
            json.dump(theirs, f)

        a = argparse.Namespace(settings=path, bin="/tmp/stratium-pep", matcher="*",
                               dry_run=False, only=None, harness="claude", force=True)
        install(a)
        got = load(path)
        cmds = [h["command"] for g in got["hooks"]["PreToolUse"] for h in g["hooks"]]
        assert "/tmp/stratium-pep hook" in cmds, cmds
        assert "my-linter" in cmds, "clobbered a hook that was not ours"
        assert len(got["hooks"]["SessionStart"]) == 1
        assert "matcher" not in got["hooks"]["SessionStart"][0], "SessionStart must stay matcher-less"
        assert got["model"] == "opus", "dropped an unrelated setting"

        install(a)  # idempotent
        got = load(path)
        assert len(got["hooks"]["PreToolUse"]) == 2, got["hooks"]["PreToolUse"]
        assert len(got["hooks"]["SessionStart"]) == 1

        a.bin = "/usr/local/bin/stratium-pep"
        install(a)  # a changed --bin replaces, does not stack
        cmds = [h["command"] for g in load(path)["hooks"]["PreToolUse"] for h in g["hooks"]]
        assert "/tmp/stratium-pep hook" not in cmds, cmds

        uninstall(a)
        got = load(path)
        assert got["model"] == "opus"
        assert got["hooks"] == {"PreToolUse": [{"matcher": "Bash", "hooks": [
            {"type": "command", "command": "my-linter"}]}]}, got["hooks"]
        assert status(a) == 1

        # --only installs one half and leaves the other alone. 1d in the agent
        # test plan needs this: a SessionStart hook there would issue a fresh
        # delegation over the one 1a made by hand and 1c edited by SQL.
        install(a)
        a.only = ["PreToolUse"]
        a.bin = "/tmp/stratium-pep"
        install(a)
        got = load(path)
        ss = [h["command"] for g in got["hooks"]["SessionStart"] for h in g["hooks"]]
        ptu = [h["command"] for g in got["hooks"]["PreToolUse"] for h in g["hooks"]]
        assert ss == ["/usr/local/bin/stratium-pep session-start"], ss
        assert "/tmp/stratium-pep hook" in ptu, ptu
        assert "/usr/local/bin/stratium-pep hook" not in ptu, ptu
        a.only = None
        uninstall(a)

        # a file that was ours alone loses the "hooks" key entirely
        with open(path, "w") as f:
            json.dump({}, f)
        install(a)
        uninstall(a)
        assert load(path) == {}, load(path)
        # --codex: its own file, its own default command, PreToolUse only.
        pr = argparse.ArgumentParser()
        def resolved(**kw):
            ns = argparse.Namespace(harness="codex", settings=None, user=False, bin=None,
                                    matcher="*", only=None, dry_run=False)
            vars(ns).update(kw)
            return resolve(ns, pr)

        c = resolved()
        assert c.settings == os.path.expanduser("~/.codex/hooks.json"), c.settings
        assert c.bin == "stratium-codex-hook", c.bin
        assert c.only == ["PreToolUse"], c.only

        # a project-local Codex hook is fail-open, not inert — refuse it
        for bad in (os.path.join(REPO, ".codex", "hooks.json"),
                    os.path.join(d, ".codex", "hooks.json")):
            try:
                resolved(settings=bad)
            except SystemExit:
                pass
            else:
                raise AssertionError(f"accepted a project-local Codex path: {bad}")

        # ...and Codex has no SessionStart to wire here
        try:
            resolved(only=["SessionStart"])
        except SystemExit:
            pass
        else:
            raise AssertionError("accepted --codex --only SessionStart")

        # Claude Code keeps the project file by default, the user file under --user
        cc = argparse.Namespace(harness="claude", settings=None, user=False, bin=None,
                                matcher="*", only=None, dry_run=False)
        # anchored to the script's own repo, not the caller's cwd
        assert resolve(cc, pr).settings == os.path.join(REPO, ".claude", "settings.json")
        cc = argparse.Namespace(harness="claude", settings=None, user=True, bin=None,
                                matcher="*", only=None, dry_run=False)
        assert resolve(cc, pr).settings == os.path.expanduser("~/.claude/settings.json")

        # the Codex block itself: same shape, one event, the shim as the command
        cx = entries("stratium-codex-hook", "*", ["PreToolUse"], HARNESS["codex"]["hook_arg"])
        assert list(cx) == ["PreToolUse"], list(cx)
        # bare, no subcommand: 2b's block is `"command": "…/stratium-codex-hook"`
        assert cx["PreToolUse"]["hooks"][0]["command"] == "stratium-codex-hook", cx
        assert entries("stratium-pep", "*", ["PreToolUse"])["PreToolUse"]["hooks"][0][
            "command"] == "stratium-pep hook"

        # a full round trip against a Codex file, including that uninstall finds
        # the shim — MARKERS has to cover a name that does not contain "stratium-pep"
        cxpath = os.path.join(d, "codex-hooks.json")
        b = argparse.Namespace(harness="codex", settings=cxpath, bin="stratium-codex-hook",
                               matcher="*", only=["PreToolUse"], dry_run=False, user=False, force=True)
        install(b)
        assert load(cxpath)["hooks"]["PreToolUse"][0]["hooks"][0][
            "command"] == "stratium-codex-hook"
        uninstall(b)
        assert load(cxpath) == {}, load(cxpath)

        # status is green only when the command runs AND the environment is whole.
        # The stub has to be *named* like ours, or ours() cannot see the entry —
        # which is the same reason install() warns about an off-name --bin.
        stub = os.path.join(d, "stratium-codex-hook")
        with open(stub, "w") as f:
            f.write("#!/bin/sh\nexit 0\n")
        os.chmod(stub, 0o755)
        b.bin = stub
        install(b)
        saved = {k: os.environ.get(k) for k in REQUIRED_ENV["PreToolUse"]}
        try:
            assert status(b) == 1, "green with an empty environment"
            for k in REQUIRED_ENV["PreToolUse"]:
                os.environ[k] = "set"
            assert not missing_env("PreToolUse")
            assert status(b) == 0, "red with a complete environment and a real command"
            del os.environ["STRATIUM_PEP_CACHE_STALENESS_WINDOW"]
            assert missing_env("PreToolUse") == ["STRATIUM_PEP_CACHE_STALENESS_WINDOW"]
            assert status(b) == 1, "green with one variable missing"
            os.environ["STRATIUM_PEP_CACHE_STALENESS_WINDOW"] = "set"
            os.unlink(stub)  # the command is gone; env is whole
            assert status(b) == 1, "green with a command that is not there"
        finally:
            for k, v in saved.items():
                os.environ.pop(k, None)
                if v is not None:
                    os.environ[k] = v
        uninstall(b)

        # a --bin that does not resolve is refused, because that install is
        # fail-open rather than broken (127 is not 2, so the tool call proceeds)
        assert resolves("/bin/sh") and resolves("sh")
        assert not resolves("/nonexistent/stratium-pep")
        assert not resolves("stratium-pep-that-is-not-installed")
        assert resolves("/bin/sh hook"), "the subcommand must not be part of the lookup"
        bad = argparse.Namespace(settings=os.path.join(d, "refuse.json"), bin="/nonexistent/pep",
                                 matcher="*", only=None, dry_run=False, harness="claude",
                                 force=False)
        try:
            install(bad)
        except SystemExit:
            assert not os.path.exists(bad.settings), "wrote settings despite refusing"
        else:
            raise AssertionError("installed a binary that does not resolve")
        bad.force = True
        install(bad)  # --force is the escape hatch
        assert os.path.exists(bad.settings)

    # REQUIRED_ENV must track the Go loaders. Skipped when the script is running
    # outside the repo, where there is no source to check against.
    src = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                       "..", "services", "cmd", "stratium-pep")
    if os.path.isdir(src):
        import re

        def literals(name):
            text = open(os.path.join(src, name)).read()
            return set(re.findall(r'"(STRATIUM_PEP_[A-Z_]+)"', text))

        want_ss = literals("session_start.go") - {"STRATIUM_PEP_PURPOSE"}  # optional
        assert set(REQUIRED_ENV["SessionStart"]) == want_ss, (
            f"SessionStart drifted from session_start.go: "
            f"{want_ss ^ set(REQUIRED_ENV['SessionStart'])}")
        want_h = literals("hook.go") | literals("cache.go")
        assert set(REQUIRED_ENV["PreToolUse"]) == want_h, (
            f"PreToolUse drifted from hook.go/cache.go: "
            f"{want_h ^ set(REQUIRED_ENV['PreToolUse'])}")

    # the guidance has to cover every required variable, or it is worse than none
    import io, contextlib
    for events in (["SessionStart", "PreToolUse"], ["PreToolUse"]):
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            next_steps(events)
        out = buf.getvalue()
        for e in events:
            for v in REQUIRED_ENV[e]:
                assert v in out, f"{v} missing from the guidance for {events}"
        assert ("session-start` by hand" in out) == (events == ["PreToolUse"]), out
    assert set(EXAMPLES) == set(REQUIRED_ENV["SessionStart"]) | set(REQUIRED_ENV["PreToolUse"]), (
        "EXAMPLES and REQUIRED_ENV disagree: "
        f"{set(EXAMPLES) ^ (set(REQUIRED_ENV['SessionStart']) | set(REQUIRED_ENV['PreToolUse']))}")

    # options must work on both sides of the subcommand, and a value given
    # before it must survive the subparser's own (suppressed) default
    pp = argparse.ArgumentParser()
    add_options(pp)
    ss = pp.add_subparsers(dest="cmd", required=True)
    for n in ("install", "status"):
        add_options(ss.add_parser(n), suppress=True)
    for argv in (["--claude", "--bin", "/x", "--matcher", "R", "install"],
                 ["--claude", "install", "--bin", "/x", "--matcher", "R"],
                 ["install", "--claude", "--bin", "/x", "--matcher", "R"],
                 ["--claude", "--bin", "/x", "install", "--matcher", "R"]):
        got = pp.parse_args(argv)
        assert (got.harness, got.bin, got.matcher) == ("claude", "/x", "R"), (argv, got)
    # an unspecified option still lands on its real default, not SUPPRESS
    got = pp.parse_args(["--codex", "install"])
    assert (got.bin, got.matcher, got.only, got.force) == (None, "*", None, False), got

    print("selftest OK")
    return 0


# Per-harness defaults. Codex differs in three ways that all matter, see Part 2
# of docs/testing/2026-08-20-agent-integration-test.md:
#   - the file is ~/.codex/hooks.json, and *only* that one (see resolve());
#   - the command is the stratium-codex-hook shim, not the bare binary, because
#     Codex reads a blocking reason off stderr and `stratium-pep hook` writes it
#     to stdout — without the shim the call is still denied but the reason is
#     lost (§2e);
#   - only PreToolUse is wired; session-start is run by hand (§2e, last para).
HARNESS = {
    "claude": {"path": ".claude/settings.json", "user_path": "~/.claude/settings.json",
               "bin": "stratium-pep", "events": ("SessionStart", "PreToolUse"),
               "hook_arg": "hook"},
    # hook_arg is empty for Codex: 2e's shim IS the hook, and calls
    # `stratium-pep hook` itself. Passing "hook" to the shim would be a stray arg.
    "codex":  {"path": "~/.codex/hooks.json", "user_path": "~/.codex/hooks.json",
               "bin": "stratium-codex-hook", "events": ("PreToolUse",),
               "hook_arg": ""},
}


def resolve(args, parser):
    """Fill in the harness-dependent defaults and refuse the fail-open setups."""
    h = HARNESS[args.harness]
    if args.bin is None:
        args.bin = h["bin"]
    if args.settings is None:
        args.settings = harness_path(args.harness, user=args.user)
    args.settings = os.path.expanduser(args.settings)

    if args.harness == "codex":
        # A project-local .codex/hooks.json is disabled until the project is
        # trusted, and a disabled enforcement hook is not a no-op — it is
        # fail-open: every tool call proceeds unchecked (§2b).
        home = os.path.expanduser("~/.codex")
        if os.path.dirname(os.path.abspath(args.settings)) != home:
            parser.error(
                f"--codex writes {home}/hooks.json only. {args.settings} looks "
                "project-local, and Codex disables project hooks until the project "
                "is trusted — an enforcement hook that does not run is fail-open, "
                "not inert (see 2b)")
        if args.only and "SessionStart" not in h["events"] and "SessionStart" in args.only:
            parser.error("--codex wires PreToolUse only; run session-start by hand (see 2e)")
        if os.path.basename(args.bin) == "stratium-pep":
            print(f"warning: --codex with {args.bin!r} loses the deny reason — Codex reads "
                  "it off stderr, the hook writes it to stdout. Use the "
                  "stratium-codex-hook shim from 2e.", file=sys.stderr)
    args.only = args.only or list(h["events"])
    return args


