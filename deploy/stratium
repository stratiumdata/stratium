def opencode_base(args):
    """The OpenCode configuration directory this install is for."""
    if getattr(args, "system", False):
        return under(args.system_root, OPENCODE_SYSTEM)
    return args.settings or os.environ.get("OPENCODE_CONFIG_DIR") or os.path.expanduser(
        "~/.config/opencode")


def opencode_config(base):
    """(path, parsed) of the directory's opencode.json, refusing what cannot be edited."""
    path = os.path.join(base, "opencode.json")
    if os.path.exists(path + "c"):
        # Comments do not survive a rewrite, and two files would both be read.
        sys.exit(f"stratium: {path}c exists and this script edits opencode.json only. "
                 "Add the entries to it by hand: `--dry-run` prints them.")
    return path, load(path)


def opencode_files(base, binary, conf, env, system, dry_run=False):
    """{path: text} for an OpenCode install rooted at `base`.

    The plugin is listed in `plugins` by path, not dropped in `plugins/`: a
    listed entry in the system file is applied after a user's own "-id"
    removal. The system install adds `plugin.use` policies so that no other
    plugin loads, which is what stops one taking this plugin's id.
    """
    guard = os.path.join(base, "stratium-guard")
    path, cfg = (os.path.join(base, "opencode.json"), {}) if dry_run else opencode_config(base)
    allow = {"action": "plugin.use", "resource": guard, "effect": "allow"}
    cfg["plugins"] = [x for x in cfg.get("plugins", []) if x != guard] + [guard]
    added_deny = False
    if system:
        policies = [x for x in cfg.get("policies", []) if x != allow]
        added_deny = OPENCODE_DENY_ALL not in policies
        cfg["policies"] = policies + ([OPENCODE_DENY_ALL] if added_deny else []) + [allow]
    files = {}
    for name in ("index.js", "package.json"):
        with open(os.path.join(OPENCODE_SRC, name)) as f:
            files[os.path.join(guard, name)] = f.read()
    files[os.path.join(guard, "stratium.json")] = json.dumps({
        "bin": binary, "config": conf, "timeoutMs": hook_timeout(env) * 1000,
        "addedDenyAll": added_deny}, indent=2) + "\n"
    files[path] = json.dumps(cfg, indent=2) + "\n"
    return files


def install_opencode(args):
    """The per-user OpenCode install: plugin, its settings, the config entry."""
    binary = shutil.which(args.bin) if os.sep not in args.bin else os.path.abspath(args.bin)
    if not binary or not resolves(binary):
        if not args.force:
            sys.exit(f"stratium: {args.bin!r} is not runnable; pass --bin with the path of a "
                     "built stratium-pep. The plugin refuses every tool call when it cannot "
                     "run it. --force writes the install anyway.")
        binary = binary or args.bin
    files = opencode_files(opencode_base(args), binary, None, os.environ, False, args.dry_run)
    for path, text in files.items():
        if args.dry_run:
            print(f"--- would write {path} ---\n{text}", end="")
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + ".tmp", "w") as f:
            f.write(text)
        os.replace(path + ".tmp", path)
        print(f"wrote {path}")
    if not args.dry_run and getattr(args, "show_next", True):
        next_steps(["SessionStart", "PreToolUse"], "opencode", binary)
    return 0


def uninstall_opencode(args):
    """Remove the plugin directory and this script's entries in opencode.json."""
    base = opencode_base(args)
    guard = os.path.join(base, "stratium-guard")
    if not os.path.isdir(guard):
        print(f"no Stratium plugin in {base}")
        return 0
    try:
        with open(os.path.join(guard, "stratium.json")) as f:
            added_deny = json.load(f).get("addedDenyAll")
    except (OSError, ValueError):
        added_deny = False
    path, cfg = opencode_config(base)
    drop = [{"action": "plugin.use", "resource": guard, "effect": "allow"}]
    if added_deny:
        drop.append(OPENCODE_DENY_ALL)
    for key, gone in (("plugins", [guard]), ("policies", drop)):
        kept = [x for x in cfg.get(key, []) if x not in gone]
        if kept:
            cfg[key] = kept
        else:
            cfg.pop(key, None)
    if args.dry_run:
        print(f"would remove {guard} and its entries in {path}")
        return 0
    # The config entry first: a listed plugin whose directory is gone fails to
    # load, which OpenCode treats as no plugin at all.
    if os.path.exists(path):
        save(path, cfg, False)
    shutil.rmtree(guard)
    print(f"removed {guard} and its entries in {path}")
    return 0


def status_opencode(args):
    base = opencode_base(args)
    guard = os.path.join(base, "stratium-guard")
    conf_path = os.path.join(guard, "stratium.json")
    if not os.path.exists(conf_path):
        print(f"no Stratium plugin in {base}")
        return 1
    with open(conf_path) as f:
        conf = json.load(f)
    path, cfg = opencode_config(base)
    binary, pep_conf, timeout = conf.get("bin") or "", conf.get("config"), conf.get("timeoutMs")
    command = binary + (f" --config {pep_conf}" if pep_conf else "")
    env = hook_env(command)
    print(f"plugin={guard!r} command={command!r} timeoutMs={timeout}")
    problems = []
    if guard not in cfg.get("plugins", []):
        problems.append(f"{path} does not list the plugin, so OpenCode will not load it")
    if not all(os.path.exists(os.path.join(guard, n)) for n in ("index.js", "package.json")):
        problems.append("plugin files are missing; OpenCode skips a plugin it cannot load")
    if not resolves(binary):
        problems.append(f"NOT RUNNABLE: {binary!r} is not there; every tool call is refused")
    gone = sorted({v for e in ("SessionStart", "PreToolUse") for v in missing_env(e, env)})
    if gone:
        problems.append(f"{'config' if pep_conf else 'env'}: missing {', '.join(gone)}")
    if not isinstance(timeout, (int, float)) or timeout < hook_timeout(env) * 1000:
        problems.append(f"timeoutMs is below {hook_timeout(env) * 1000}; a call waiting "
                        "for approval is refused before the approval can arrive")
    if getattr(args, "system", False) and (
            OPENCODE_DENY_ALL not in cfg.get("policies", [])
            or {"action": "plugin.use", "resource": guard, "effect": "allow"}
            not in cfg.get("policies", [])):
        problems.append(f"{path} lacks the plugin.use policies; another plugin can load")
    for line in problems:
        print(f"  {line}")
    open_to = sorted({(w, h) for w, h in [("plugin", writable_here(guard)),
                                          ("OpenCode config", writable_here(path))]
                      + exposed(command) if h})
    for what, hit in open_to:
        print(f"warning: {what} is writable by you: {hit}")
    if open_to:
        print(f"         {EXPOSED_FIX.format('opencode')}")
    return 1 if problems else 0


def requirements_toml(wanted):
    """Codex's requirements.toml for `wanted`: these hooks, no others, hooks on.

    `allow_managed_hooks_only` makes Codex ignore every hook that is not in
    this file; the `features` entry stops a user configuration turning hooks off.
    """
    out = [CODEX_MARK, "\nallow_managed_hooks_only = true\n\n[features]\nhooks = true\n"]
    for event, group in wanted.items():
        out.append(f"\n[[hooks.{event}]]\n")
        if "matcher" in group:
            out.append(f"matcher = {json.dumps(group['matcher'])}\n")
        for h in group["hooks"]:
            out.append(f"\n[[hooks.{event}.hooks]]\ntype = \"command\"\n"
                       f"command = {json.dumps(h['command'])}\ntimeout = {h['timeout']}\n")
    return "".join(out)


def ours_toml(path):
    with open(path) as f:
        return f.readline().rstrip("\n") == CODEX_MARK


def load_hooks(path):
    """`load`, for either kind of hook file.

    ponytail: reads back requirements_toml()'s own output, not TOML at large;
    a file this script did not write reads as holding no hooks. Use tomllib
    once Python 3.11 is the floor.
    """
    if not path.endswith(".toml"):
        return load(path)
    hooks = {}
    if not os.path.exists(path) or not ours_toml(path):
        return {"hooks": hooks}
    group = None
    with open(path) as f:
        for line in f:
            m = re.match(r"\[\[hooks\.(\w+)(\.hooks)?\]\]", line)
            if m and m.group(2):
                group["hooks"].append({})
            elif m:
                group = {"hooks": []}
                hooks.setdefault(m.group(1), []).append(group)
            elif line.startswith("["):
                group = None
            elif group is not None and "=" in line:
                key, value = line.split("=", 1)
                (group["hooks"][-1] if group["hooks"] else group)[key.strip()] = json.loads(value)
    return {"hooks": hooks}


def under(root, path):
    """`path` relocated beneath `root` ("/" in real use, a temp dir in selftest)."""
    return os.path.join(root, path.lstrip("/"))


def writable_here(path):
    """The first of `path` and the directories above it that this user can change.

    A writable directory counts even when the file itself is read-only: whoever
    can write a directory can replace what is in it. A sticky directory (/tmp)
    does not, since it lets you replace only your own files.
    """
    p = os.path.realpath(path)
    first = True
    while True:
        if os.path.exists(p) and os.access(p, os.W_OK) and (
                first or not os.stat(p).st_mode & 0o1000):
            return p
        first = False
        parent = os.path.dirname(p)
        if parent == p:
            return None
        p = parent


def not_root_only(path):
    """The first of `path` and the directories above it a non-root user can change."""
    p = os.path.realpath(path)
    while True:
        st = os.stat(p)
        if st.st_uid != 0 or st.st_mode & 0o022:
            return p
        parent = os.path.dirname(p)
        if parent == p:
            return None
        p = parent


def exposed(command):
    """Files behind a hook command that this user can change: [(what, path)]."""
    words = (command or "").split()
    if not words:
        return []
    files = [("binary", words[0] if os.sep in words[0] else shutil.which(words[0]))]
    if "--config" in words[:-1]:
        files.append(("configuration", words[words.index("--config") + 1]))
    return [(what, hit) for what, f in files if f
            for hit in [writable_here(f)] if hit]


EXPOSED_FIX = ("the agent runs as you, so it can change this and stop being governed; "
               "`sudo -E deploy/stratium --{} install --system` puts it out of reach")


def install_system(args):
    """Install where only root can write: binary, configuration, managed hook entry."""
    root = args.system_root
    h = HARNESS[args.harness]
    real = root == "/" and not args.dry_run
    if real and os.geteuid() != 0:
        sys.exit("stratium: --system writes root-owned files; run it with sudo -E "
                 "(-E keeps the STRATIUM_PEP_* variables it records)")
    src = shutil.which(args.bin) if os.sep not in args.bin else args.bin
    if not src or not resolves(src):
        sys.exit(f"stratium: {args.bin!r} is not runnable; pass --bin with the path "
                 "of a built stratium-pep")
    pinned = {k: v for k, v in sorted(os.environ.items())
              if k.startswith("STRATIUM_PEP_") and v}
    need = [v for e in ("SessionStart", "PreToolUse") for v in REQUIRED_ENV[e]]
    gone = sorted({v for v in need if v not in pinned})
    if gone:
        sys.exit(f"stratium: --system records the hook's configuration in {SYSTEM_CONF}, "
                 f"and {len(gone)} required values are not set here: {', '.join(gone)}. "
                 "Export them, then use sudo -E so they survive sudo.")
    if any("\n" in v for v in pinned.values()):
        sys.exit("stratium: a STRATIUM_PEP_* value contains a newline")

    binary, conf = under(root, SYSTEM_BIN), under(root, SYSTEM_CONF)
    settings = under(root, SYSTEM_HOOKS[args.harness])
    command = f"{binary} --config {conf}"
    if " " in command.replace(" --config ", ""):
        sys.exit("stratium: the install path must not contain spaces")
    body = "".join(f"{k}={v}\n" for k, v in pinned.items())
    if args.harness == "opencode":
        extra = opencode_files(opencode_base(args), binary, conf, pinned, True)
    else:
        wanted = entries(binary, args.matcher, h["events"], h["hook_arg"], tail=f" --config {conf}")
        extra = {settings: json.dumps({"hooks": {e: [g] for e, g in wanted.items()}},
                                      indent=2) + "\n"}
    if args.harness == "cursor":
        # One file for every administrator hook: add to it, keep what is there.
        merged = load(settings)
        strip(merged)
        merged.setdefault("version", 1)
        for event, entry in wanted.items():
            merged.setdefault("hooks", {}).setdefault(event, []).append(entry)
        extra = {settings: json.dumps(merged, indent=2) + "\n"}
    if args.harness == "codex":
        if os.path.exists(settings) and not ours_toml(settings):
            # Codex has one such file and this script cannot merge TOML into
            # somebody else's without risking the rules already in it.
            sys.exit(f"stratium: {settings} exists and was not written by this script. "
                     "Add the hooks to it by hand: `--dry-run` prints them.")
        extra = {settings: requirements_toml(wanted)}
    extra[conf] = body
    if args.dry_run:
        print(f"--- would copy {src} to {binary} ---")
        for path, text in sorted(extra.items(), key=lambda kv: kv[0] != conf):
            print(f"--- would write {path} ---\n{text}", end="")
        return 0

    for path, mode in [(binary, 0o755)] + [(f, 0o644) for f in sorted(extra, key=lambda f: f != conf)]:
        os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
        os.close(fd)
        if path == binary:
            shutil.copyfile(src, tmp)
        else:
            with open(tmp, "w") as f:
                f.write(extra[path])
        os.chmod(tmp, mode)
        os.replace(tmp, path)
        if real:
            open_to = not_root_only(path)
            if open_to:
                sys.exit(f"stratium: {open_to} can be changed by a non-root user, so "
                         f"{path} is not protected. Fix its owner and mode, then re-run.")
        print(f"wrote {path}")
    if args.harness == "cursor":
        print("\nNEXT — restart Cursor. Its documentation says administrator hooks need an "
              "Enterprise plan; whether\nthis file is read without one is not known, so "
              "check that a tool call is refused before relying\non it. The session file "
              "path recorded above must stay writable by the user who runs the agent.")
        return 0
    if args.harness == "opencode":
        print("\nNEXT — restart OpenCode. It now loads this plugin and refuses every other "
              "one, by the plugin.use\npolicies added to its system opencode.json. macOS "
              "managed preferences, when present, outrank\nthat file. The session file "
              "path recorded above must stay writable by the user who runs the agent.")
        return 0
    if args.harness == "codex":
        print("\nNEXT — restart any running Codex session. Codex now runs these hooks and "
              "ignores every other one,\nincluding hooks in ~/.codex/hooks.json and in "
              "plugins. A cloud-managed or MDM requirements source,\nwhen present, is "
              "read ahead of this file. The session file path recorded above must stay\n"
              "writable by the user who runs the agent.")
        return 0
    print("\nNEXT — restart any running Claude Code session, then check that `/status` "
          "lists the managed settings\nas a source: when another policy source (MDM, "
          "server-managed settings) is present, Claude Code\nmay use that one and ignore "
          "this file. The session file path recorded above must stay writable\nby the "
          "user who runs the agent.")
    return 0


def uninstall_system(args):
    """Remove exactly what install_system wrote.

    The binary and the configuration are shared by every harness's system
    install. They stay while any hook file still runs the binary: a hook whose
    command is gone does not block the tool call on every harness.
    """
    root = args.system_root
    mine, binary = under(root, SYSTEM_HOOKS[args.harness]), under(root, SYSTEM_BIN)
    going = os.path.exists(mine) and not (mine.endswith(".toml") and not ours_toml(mine))
    if args.harness == "opencode":
        uninstall_opencode(args)  # the plugin directory and the config entries
    if args.harness == "cursor" and going:
        # Take our entries out of the shared file; remove it only if it is then empty.
        rest = load(mine)
        strip(rest)
        going = not rest
        if rest and not args.dry_run:
            save(mine, rest, False)
            print(f"removed the Stratium hooks from {mine}")
    in_use = []
    for f in sorted(under(root, f) for f in SYSTEM_HOOKS.values()):
        if os.path.exists(f) and not (f == mine and going):
            with open(f) as fh:
                if binary in fh.read():
                    in_use.append(f)
    for path in (mine, under(root, SYSTEM_CONF), binary):
        if path == mine and args.harness == "opencode":
            continue
        if not os.path.exists(path):
            print(f"not there: {path}")
        elif path == mine and not going:
            if args.harness != "cursor":
                print(f"left alone, not written by this script: {path}")
        elif path != mine and in_use:
            print(f"kept, still used by {', '.join(in_use)}: {path}")
        elif args.dry_run:
            print(f"would remove {path}")
        else:
            os.unlink(path)
            print(f"removed {path}")
    return 0


def uninstall(args):
    if getattr(args, "system", False):
        return uninstall_system(args)
    if args.harness == "opencode":
        return uninstall_opencode(args)
    settings = load(args.settings)
    removed = strip(settings)
    if not removed:
        print(f"no Stratium hooks in {args.settings}")
        return
    save(args.settings, settings, args.dry_run)
    print(f"removed {removed} Stratium hook(s) from {args.settings}")


def status(args):
    if args.harness == "opencode":
        return status_opencode(args)
    settings = load_hooks(args.settings)
    found = [
        (event, h.get("command"), h.get("timeout"), group.get("matcher"), h)
        for event, groups in (settings.get("hooks") or {}).items()
        if isinstance(groups, list)
        for group in groups
        for h in hooks_of(group)
        if ours(h)
    ]
    if not found:
        print(f"no Stratium hooks in {args.settings}")
        return 1
    open_to = [("hook entry", writable_here(args.settings))]
    incomplete = False
    for shown, command, timeout, matcher, h in found:
        event = claude_event(shown)
        m = "" if matcher is None else f" matcher={matcher!r}"
        print(f"{shown}{m} command={command!r} timeout={timeout}")
        runnable = resolves(command)
        env = hook_env(command)
        gone = missing_env(event, env)
        if shown == "preToolUse" and h.get("failClosed") is not True:
            print("  failClosed: NOT SET — Cursor runs the tool call when this hook "
                  "crashes, times out or prints nothing")
            incomplete = True
        if not runnable:
            print(f"  command: NOT RUNNABLE — {command.split()[0]!r} is not there")
        where = "config" if env is not os.environ else "env"
        if gone:
            print(f"  {where}: missing {', '.join(gone)}")
        elif REQUIRED_ENV.get(event):
            print(f"  {where}: all {len(REQUIRED_ENV[event])} set")
        short = timeout_too_short(event, timeout, env)
        if short:
            print(f"  timeout: TOO SHORT — needs at least {hook_timeout(env)}; {TIMEOUT_FIX}")
        open_to += exposed(command)
        incomplete = incomplete or gone or not runnable or short
    # A warning, not a failure: a per-project install is a supported setup.
    open_to = sorted({(w, h) for w, h in open_to if h})
    for what, hit in open_to:
        print(f"warning: {what} is writable by you: {hit}")
    if open_to:
        print(f"         {EXPOSED_FIX.format(args.harness)}")
    if incomplete and getattr(args, "system", False):
        print(f"\nre-run: sudo -E deploy/stratium --{args.harness} install --system")
        return 1
    if incomplete:
        next_steps([claude_event(f[0]) for f in found], args.harness, found[0][1] or args.bin)
        return 1
    return 0


def selftest(_args):
    """Round-trip the install/uninstall pair over a settings file with a neighbour."""
    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, ".claude", "settings.json")
        os.makedirs(os.path.dirname(path))
        theirs = {
            "model": "opus",
            "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [
                {"type": "command", "command": "my-linter"}]}]},
        }
        with open(path, "w") as f:
            json.dump(theirs, f)

        a = argparse.Namespace(settings=path, bin="/tmp/stratium-pep", matcher="*",
                               dry_run=False, only=None, harness="claude", force=True)
        install(a)
        got = load(path)
        cmds = [h["command"] for g in got["hooks"]["PreToolUse"] for h in g["hooks"]]
        assert "/tmp/stratium-pep hook" in cmds, cmds
        assert "my-linter" in cmds, "clobbered a hook that was not ours"
        assert len(got["hooks"]["SessionStart"]) == 1
        assert "matcher" not in got["hooks"]["SessionStart"][0], "SessionStart must stay matcher-less"
        assert got["model"] == "opus", "dropped an unrelated setting"

        install(a)  # idempotent
        got = load(path)
        assert len(got["hooks"]["PreToolUse"]) == 2, got["hooks"]["PreToolUse"]
        assert len(got["hooks"]["SessionStart"]) == 1

        a.bin = "/usr/local/bin/stratium-pep"
        install(a)  # a changed --bin replaces, does not stack
        cmds = [h["command"] for g in load(path)["hooks"]["PreToolUse"] for h in g["hooks"]]
        assert "/tmp/stratium-pep hook" not in cmds, cmds

        uninstall(a)
        got = load(path)
        assert got["model"] == "opus"
        assert got["hooks"] == {"PreToolUse": [{"matcher": "Bash", "hooks": [
            {"type": "command", "command": "my-linter"}]}]}, got["hooks"]
        assert status(a) == 1

        # --only installs one half and leaves the other alone. 1d in the agent
        # test plan needs this: a SessionStart hook there would issue a fresh
        # delegation over the one 1a made by hand and 1c edited by SQL.
        install(a)
        a.only = ["PreToolUse"]
        a.bin = "/tmp/stratium-pep"
        install(a)
        got = load(path)
        ss = [h["command"] for g in got["hooks"]["SessionStart"] for h in g["hooks"]]
        ptu = [h["command"] for g in got["hooks"]["PreToolUse"] for h in g["hooks"]]
        assert ss == ["/usr/local/bin/stratium-pep session-start"], ss
        assert "/tmp/stratium-pep hook" in ptu, ptu
        assert "/usr/local/bin/stratium-pep hook" not in ptu, ptu
        a.only = None
        uninstall(a)

        # a file that was ours alone loses the "hooks" key entirely
        with open(path, "w") as f:
            json.dump({}, f)
        install(a)
        uninstall(a)
        assert load(path) == {}, load(path)
        # --codex: its own file, its own default command, its own events.
        pr = argparse.ArgumentParser()
        def resolved(**kw):
            ns = argparse.Namespace(harness="codex", settings=None, user=False, bin=None,
                                    matcher="*", only=None, dry_run=False)
            vars(ns).update(kw)
            return resolve(ns, pr)

        c = resolved()
        assert c.settings == os.path.expanduser("~/.codex/hooks.json"), c.settings
        assert c.bin == "stratium-pep", c.bin
        assert c.only == ["SessionStart", "PreToolUse", "PostToolUse"], c.only

        # a project-local Codex hook is fail-open, not inert — refuse it
        for bad in (os.path.join(REPO, ".codex", "hooks.json"),
                    os.path.join(d, ".codex", "hooks.json")):
            try:
                resolved(settings=bad)
            except SystemExit:
                pass
            else:
                raise AssertionError(f"accepted a project-local Codex path: {bad}")

        # ...and an event Codex does not have is refused, not written and never run
        assert resolved(only=["SessionStart"]).only == ["SessionStart"]
        try:
            resolved(only=["PostToolUseFailure"])
        except SystemExit:
            pass
        else:
            raise AssertionError("accepted --codex --only PostToolUseFailure")

        # Claude Code keeps the project file by default, the user file under --user
        cc = argparse.Namespace(harness="claude", settings=None, user=False, bin=None,
                                matcher="*", only=None, dry_run=False)
        # anchored to the script's own repo, not the caller's cwd
        assert resolve(cc, pr).settings == os.path.join(REPO, ".claude", "settings.json")
        cc = argparse.Namespace(harness="claude", settings=None, user=True, bin=None,
                                matcher="*", only=None, dry_run=False)
        assert resolve(cc, pr).settings == os.path.expanduser("~/.claude/settings.json")

        # the Codex block itself: same shape, one event, the binary told whose hook it is
        cx = entries("stratium-pep", "*", ["PreToolUse"], HARNESS["codex"]["hook_arg"])
        assert list(cx) == ["PreToolUse"], list(cx)
        assert cx["PreToolUse"]["hooks"][0]["command"] == "stratium-pep hook --harness codex", cx
        # onFailure is Claude Code's own key; Codex gets no key it does not define
        assert "onFailure" not in cx["PreToolUse"]["hooks"][0], cx
        assert entries("stratium-pep", "*", ["PreToolUse"])["PreToolUse"]["hooks"][0][
            "command"] == "stratium-pep hook"
        assert entries("stratium-pep", "*")["PreToolUse"]["hooks"][0]["onFailure"] == "block"
        assert "onFailure" not in cx["PreToolUse"]["hooks"][0], cx
        # report rides on both post-tool events with the decision hook's matcher
        both = entries("stratium-pep", "Bash")
        for ev in ("PostToolUse", "PostToolUseFailure"):
            assert both[ev]["matcher"] == "Bash", both
            assert both[ev]["hooks"][0]["command"] == "stratium-pep report", both

        # --system: three files under a relocated root, and uninstall removes them
        sroot = os.path.join(d, "sysroot")
        src = os.path.join(d, "stratium-pep")
        with open(src, "w") as f:
            f.write("#!/bin/sh\n")
        os.chmod(src, 0o755)
        kept_env = dict(os.environ)
        for v in set(REQUIRED_ENV["SessionStart"]) | set(REQUIRED_ENV["PreToolUse"]):
            os.environ[v] = "5s" if "TIMEOUT" in v or "INTERVAL" in v else "x"
        os.environ["STRATIUM_PEP_PDP_ADDR"] = "pdp.example:50051"
        try:
            sa = argparse.Namespace(harness="claude", system=True, system_root=sroot,
                                    bin=src, matcher="*", dry_run=False)
            with contextlib.redirect_stdout(io.StringIO()):
                assert install_system(sa) == 0
            sbin, sconf = under(sroot, SYSTEM_BIN), under(sroot, SYSTEM_CONF)
            sset = load(under(sroot, MANAGED_SETTINGS))
            assert os.access(sbin, os.X_OK) and os.stat(sconf).st_mode & 0o777 == 0o644
            assert "STRATIUM_PEP_PDP_ADDR=pdp.example:50051\n" in open(sconf).read()
            assert (sset["hooks"]["PreToolUse"][0]["hooks"][0]["command"]
                    == f"{sbin} hook --config {sconf}"), sset
            assert (sset["hooks"]["SessionStart"][0]["hooks"][0]["command"]
                    == f"{sbin} session-start --config {sconf}"), sset
            for ev in ("PostToolUse", "PostToolUseFailure"):
                assert (sset["hooks"][ev][0]["hooks"][0]["command"]
                        == f"{sbin} report --config {sconf}"), sset
            # the relocated root is ours, so every one of the three reads as exposed
            assert [w for w, _ in exposed(f"{sbin} hook --config {sconf}")] == [
                "binary", "configuration"]
            assert not_root_only(sbin) == os.path.realpath(sbin)
            # status reads a pinned hook's settings from its file, not this shell
            pinned_cmd = f"{sbin} hook --config {sconf}"
            assert hook_env(pinned_cmd)["STRATIUM_PEP_PDP_ADDR"] == "pdp.example:50051"
            assert hook_env("stratium-pep hook") is os.environ
            assert hook_timeout({"STRATIUM_PEP_APPROVAL_TIMEOUT": "5s",
                                 "STRATIUM_PEP_CONNECT_TIMEOUT": "2s"}) == 23
            del os.environ["STRATIUM_PEP_SUBJECT"]
            try:
                install_system(sa)
                raise AssertionError("install --system ran without a required value")
            except SystemExit as e:
                assert "STRATIUM_PEP_SUBJECT" in str(e), e
            with contextlib.redirect_stdout(io.StringIO()):
                uninstall_system(sa)
            assert not os.path.exists(sbin) and not os.path.exists(sconf)

            # --codex --system: the same binary and configuration, Codex's own file
            os.environ["STRATIUM_PEP_SUBJECT"] = "x"
            sx = argparse.Namespace(harness="codex", system=True, system_root=sroot,
                                    bin=src, matcher="*", dry_run=False)
            sreq = under(sroot, CODEX_REQUIREMENTS)
            with contextlib.redirect_stdout(io.StringIO()):
                assert install_system(sx) == 0
            text = open(sreq).read()
            assert text.startswith(CODEX_MARK + "\n") and "allow_managed_hooks_only = true" in text
            assert "[features]\nhooks = true\n" in text, text
            try:
                import tomllib
                parsed = tomllib.loads(text)  # real TOML, where Python can check
                assert parsed["allow_managed_hooks_only"] is True, parsed
                assert parsed["hooks"] == load_hooks(sreq)["hooks"], parsed
            except ImportError:
                pass
            got = load_hooks(sreq)["hooks"]
            assert list(got) == ["SessionStart", "PreToolUse", "PostToolUse"], got
            assert got["PreToolUse"][0]["matcher"] == "*", got
            assert got["PreToolUse"][0]["hooks"][0] == {
                "type": "command", "timeout": hook_timeout(),
                "command": f"{sbin} hook --harness codex --config {sconf}"}, got
            assert got["SessionStart"][0]["hooks"][0]["command"] == (
