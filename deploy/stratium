# What identifies our entries on the way back out. Every harness now runs the
# binary itself; the second name is the shell shim older Codex installs used,
# kept so `status` and `uninstall` still find those.
MARKERS = ("stratium-pep", "stratium-codex-hook")


def ours(hook):
    return any(m in str(hook.get("command", "")) for m in MARKERS)

# Timeouts are the harness's own hook-execution budget, in seconds.
# SessionStart's is deliberately larger than STRATIUM_PEP_CONNECT_TIMEOUT so a
# slow-but-answering PDP finishes before the harness gives up on the process.
# PreToolUse's is computed: see hook_timeout().
SESSION_START_TIMEOUT = 15
REPORT_TIMEOUT = 15
HOOK_TIMEOUT_MARGIN = 10


# What each hook needs in its environment, per the binary's own loaders: eight
# for `session-start`, seven for `hook`. They share five and differ in the rest:
# `hook` wants the two approval durations, `session-start` wants what the
# delegation is for. Exporting 1a's block satisfies session-start and leaves
# `hook` denying every call. selftest cross-checks these against the Go source.
REPORT_ENV = ("STRATIUM_PEP_PDP_ADDR", "STRATIUM_PEP_SESSION_FILE",
              "STRATIUM_PEP_CONNECT_TIMEOUT")
REQUIRED_ENV = {
    # services/cmd/stratium-pep/session_start.go (STRATIUM_PEP_PURPOSE is optional)
    "SessionStart": (
        "STRATIUM_PEP_PDP_ADDR", "STRATIUM_PEP_AGENT_ID", "STRATIUM_PEP_SUBJECT",
        "STRATIUM_PEP_SESSION_FILE", "STRATIUM_PEP_CONNECT_TIMEOUT",
        "STRATIUM_PEP_REQUESTED_TIER", "STRATIUM_PEP_REQUESTED_TOOLS",
        "STRATIUM_PEP_TTL_SECONDS",
    ),
    # services/cmd/stratium-pep/hook.go
    "PreToolUse": (
        "STRATIUM_PEP_PDP_ADDR", "STRATIUM_PEP_AGENT_ID", "STRATIUM_PEP_SUBJECT",
        "STRATIUM_PEP_SESSION_FILE", "STRATIUM_PEP_CONNECT_TIMEOUT",
        "STRATIUM_PEP_APPROVAL_POLL_INTERVAL", "STRATIUM_PEP_APPROVAL_TIMEOUT",
    ),
    # services/cmd/stratium-pep/report.go -- a subset of PreToolUse's
    "PostToolUse": REPORT_ENV,
    "PostToolUseFailure": REPORT_ENV,
}


