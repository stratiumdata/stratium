# Per-harness defaults. Codex differs in three ways that all matter, see Part 2
# of docs/testing/2026-08-20-agent-integration-test.md:
#   - the file is ~/.codex/hooks.json, and *only* that one (see resolve());
#   - the command carries `--harness codex`, because Codex reads a blocking
#     reason off stderr and blocks on exit 2 only; the flag makes the hook
#     answer that way and tells the PDP whose tool names these are;
#   - there is no PostToolUseFailure event: Codex runs PostToolUse after a tool
#     call that succeeded and nothing after one that failed, so a failed call
#     is never reported.
HARNESS = {
    "claude": {"path": ".claude/settings.json", "user_path": "~/.claude/settings.json",
               "bin": "stratium-pep",
               "events": ("SessionStart", "PreToolUse", "PostToolUse", "PostToolUseFailure"),
               "hook_arg": "hook"},
    "codex":  {"path": "~/.codex/hooks.json", "user_path": "~/.codex/hooks.json",
               "bin": "stratium-pep",
               "events": ("SessionStart", "PreToolUse", "PostToolUse"),
               "hook_arg": "hook --harness codex"},
    # User scope only, like Codex: a project .cursor/hooks.json runs only in a
    # workspace the user has trusted. No PostToolUseFailure trap here: Cursor
    # has that event, and `report` skips the calls it fires for that were denied.
    "cursor": {"path": "~/.cursor/hooks.json", "user_path": "~/.cursor/hooks.json",
               "bin": "stratium-pep",
               "events": ("SessionStart", "PreToolUse", "PostToolUse", "PostToolUseFailure"),
               "hook_arg": "hook --harness cursor"},
    # No hook file and no events: see install_opencode. `--settings` names the
    # OpenCode configuration directory.
    "opencode": {"bin": "stratium-pep", "events": ()},
}


def resolve(args, parser):
    """Fill in the harness-dependent defaults and refuse the fail-open setups."""
    h = HARNESS[args.harness]
    if args.harness == "opencode":
        if args.only or args.user or args.matcher != "*":
            parser.error("--opencode takes no --only, --user or --matcher: its plugin "
                         "checks every tool call, from the user configuration directory")
        if getattr(args, "system", False) and args.bin is None and os.path.exists(PEP_BIN):
            args.bin = PEP_BIN
        args.bin = args.bin or h["bin"]
        return args
    if getattr(args, "system", False):
        args.settings = under(args.system_root, SYSTEM_HOOKS[args.harness])
        if args.bin is None and os.path.exists(PEP_BIN):
            args.bin = PEP_BIN  # the binary to copy: the quickstart's build, if any
    if args.bin is None:
        args.bin = h["bin"]
    if args.settings is None:
        args.settings = harness_path(args.harness, user=args.user)
    args.settings = os.path.expanduser(args.settings)

    if args.harness in ("codex", "cursor") and not getattr(args, "system", False):
        # A project-local hooks.json is disabled until the project is trusted
        # (both harnesses), and a disabled enforcement hook is not a no-op — it
        # is fail-open: every tool call proceeds unchecked (§2b).
        home = os.path.expanduser(f"~/.{args.harness}")
        name = "Codex" if args.harness == "codex" else "Cursor"
        if os.path.dirname(os.path.abspath(args.settings)) != home:
            parser.error(
                f"--{args.harness} writes {home}/hooks.json only. {args.settings} looks "
                f"project-local, and {name} disables project hooks until the project "
                "is trusted — an enforcement hook that does not run is fail-open, "
                "not inert (see 2b)")
    unknown = [e for e in args.only or () if e not in h["events"]]
    if unknown:
        # An event the harness does not have is written and never run, which
        # reads as installed and enforces nothing.
        parser.error(f"--{args.harness} has no {', '.join(unknown)} event; "
                     f"it has {', '.join(h['events'])}")
    args.only = args.only or list(h["events"])
    return args


